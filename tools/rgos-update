#!/bin/sh
# RG OS firmware updater. It is copied into the initramfs (see build.sh initrd) and run by /init AFTER the ext4
# root is mounted on $NEWROOT, the exFAT ROMS partition on $ROMS and the FAT32 boot partition on $BOOT, but BEFORE
# switch_root. Nothing on the root filesystem is in use at that point, so it can be wiped and replaced safely.
#
# Looks for  $ROMS/update/*.tar  (built by ./build.sh, name rgos-update-<BUILD_ID>.tar). If several are present the
# newest name wins and the others are renamed *.old. The file is handled afterwards so it never applies twice:
#     deleted       applied (or that build was already installed); superseded *.old files and *.done leftovers
#                   from older versions of this script are deleted with it
#     *.tar.failed  rejected BEFORE anything was changed (damaged file, wrong device, root too small, ...)
# If the power fails while the root is being replaced the file stays *.tar and the update restarts on next boot.
# Progress and errors go to the screen and to $ROMS/update/update.log. This script never returns an error:
# the boot always continues.
#
# Update tar layout:  manifest  SHA256SUMS  boot/{Image,initrd.gz,rgos.dtb,extlinux/extlinux.conf[,boot.img]}  rootfs.tar.gz
# TARGET in the manifest must be rgos-<device>, where <device> is /etc/rgos-device of the installed root (default rg34xx-sp)
# Only POSIX sh + busybox applets are used. Paths can be overridden through the environment (for testing).

NEWROOT=${NEWROOT:-/newroot}
ROMS=${ROMS:-/roms}
BOOT=${BOOT:-/boot}
TMP=${TMP:-/tmp/rgos-upd}
KEEP=${KEEP:-/tmp/rgos-keep}
UPD=$ROMS/update
LOG=$UPD/update.log

[ -d "$UPD" ] || exit 0

say() { echo "RGOS-UPDATE: $*"; echo "$*" >> "$LOG" 2>/dev/null; }
isnum() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; return 0; }
cleanup() { rm -rf "$TMP" "$KEEP"; }

# newest *.tar (by name) wins; older ones are superseded
f=
for x in "$UPD"/*.tar; do
    [ -f "$x" ] || continue
    [ -z "$f" ] || mv "$f" "$f.old" 2>/dev/null
    f=$x
done
[ -n "$f" ] || exit 0
name=$(basename "$f")

# update applied: delete the tar (and superseded/old leftovers) to free space on the ROMS partition
consume() {
    rm -f "$f" "$UPD"/*.tar.old "$UPD"/*.tar.done 2>/dev/null
    sync
}

# rejected before the system was touched: rename so it is not retried every boot
fail() {
    say "FAILED: $*"
    say "$name renamed to $name.failed - the system was NOT changed"
    mv "$f" "$f.failed" 2>/dev/null
    cleanup; exit 0
}
# failed after the root filesystem was wiped: keep the file so the next boot retries
fail_keep() {
    say "FAILED: $*"
    say "the root filesystem may be incomplete; the update is retried on the next boot ($name kept)"
    cleanup; exit 0
}

say "=== found $name ==="
cleanup; mkdir -p "$TMP/boot/extlinux" "$KEEP" || fail "no scratch space"

FILES="boot/Image boot/initrd.gz boot/rgos.dtb boot/extlinux/extlinux.conf"
# shellcheck disable=SC2086
tar -xf "$f" -C "$TMP" manifest SHA256SUMS $FILES 2>/dev/null
for x in manifest SHA256SUMS $FILES; do
    [ -s "$TMP/$x" ] || fail "not a complete RG OS update file (missing $x)"
done

get() { sed -n "s/^$1=//p" "$TMP/manifest" | head -n 1; }
[ "$(get FORMAT)" = 1 ] || fail "unsupported update format '$(get FORMAT)'"
dev=$(head -n 1 "$NEWROOT/etc/rgos-device" 2>/dev/null); [ -n "$dev" ] || dev=rg34xx-sp      # roots without the marker file are RG34XX-SP
[ "$(get TARGET)" = "rgos-$dev" ] || fail "this update is for '$(get TARGET)', not for this device (rgos-$dev)"
HAVE_BI=0
if [ "$(get BOOTIMG)" = 1 ]; then       # TSP with a bootm-only U-Boot also boots from /boot.img
    tar -xf "$f" -C "$TMP" boot/boot.img 2>/dev/null
    [ -s "$TMP/boot/boot.img" ] || fail "not a complete RG OS update file (missing boot/boot.img)"
    HAVE_BI=1
fi

new=$(get BUILD_ID)
cur=$(sed -n 's/^BUILD_ID=//p' "$NEWROOT/etc/rgos-release" 2>/dev/null | head -n 1)
say "installed build: ${cur:-unknown}   update build: $new"
if [ -n "$cur" ] && [ "$cur" = "$new" ]; then
    say "this build is already installed - nothing to do ($name deleted)"
    consume; cleanup; exit 0
fi

# the boot partition has to be writable too (the kernel/initramfs/DTB are replaced)
[ -f "$BOOT/extlinux/extlinux.conf" ] || fail "boot partition is not available"

# does the new root fit into the existing root partition? (it cannot be resized on the device)
need_kb=$(get ROOTFS_KB); need_files=$(get ROOTFS_FILES)
have_kb=$(df -k "$NEWROOT" 2>/dev/null | awk 'END{print $2}')
have_files=$(df -i "$NEWROOT" 2>/dev/null | awk 'END{print $2}')
if isnum "$need_kb" && isnum "$have_kb" && [ "$have_kb" -lt "$need_kb" ]; then
    fail "new root needs $((need_kb / 1024)) MB but the root partition only holds $((have_kb / 1024)) MB - flash the full image instead"
fi
if isnum "$need_files" && isnum "$have_files" && [ "$have_files" -lt $((need_files + 100)) ]; then
    fail "new root needs $need_files files but the root partition only has $have_files inodes - flash the full image instead"
fi

# verify everything BEFORE wiping anything
say "verifying update file, please wait..."
nver=0
while read -r sum fn; do
    fn=${fn#\*}
    case "$fn" in
        rootfs.tar.gz) got=$(tar -xOf "$f" rootfs.tar.gz | sha256sum | cut -d' ' -f1) ;;
        boot/Image|boot/initrd.gz|boot/rgos.dtb|boot/extlinux/extlinux.conf|boot/boot.img)
            got=$(sha256sum "$TMP/$fn" | cut -d' ' -f1) ;;
        *) continue ;;
    esac
    [ "$got" = "$sum" ] || fail "checksum mismatch on $fn (damaged while copying?)"
    nver=$((nver + 1))
done < "$TMP/SHA256SUMS"
[ "$nver" -eq $((5 + HAVE_BI)) ] || fail "SHA256SUMS does not cover all update files"

# ---- point of no return ----------------------------------------------------------------------------------------
say "installing the new root filesystem - DO NOT POWER OFF (this takes a few minutes)"
[ -d "$NEWROOT/var/lib/rgos" ] && cp -a "$NEWROOT/var/lib/rgos" "$KEEP/rgos"
rm -f "$BOOT"/*.new 2>/dev/null

for e in "$NEWROOT"/* "$NEWROOT"/.[!.]*; do
    [ -e "$e" ] || [ -L "$e" ] || continue
    case "$e" in */lost+found) continue ;; esac
    rm -rf "$e"
done
sync

RC=$TMP/rc; rm -f "$RC"
( tar -xOf "$f" rootfs.tar.gz | tar -xzpf - -C "$NEWROOT" -v 2>&1; echo $? > "$RC" ) |
    awk '/^tar:/ { print "RGOS-UPDATE: " $0 } { n++ } n % 3000 == 0 { printf "RGOS-UPDATE:   %d files...\n", n; fflush() }'
[ "$(cat "$RC" 2>/dev/null)" = 0 ] || fail_keep "unpacking the root filesystem failed (exit code $(cat "$RC" 2>/dev/null))"
sync

# keep the first-boot flag so ROMS is not re-checked needlessly
if [ -d "$KEEP/rgos" ]; then
    mkdir -p "$NEWROOT/var/lib"; rm -rf "$NEWROOT/var/lib/rgos"; cp -a "$KEEP/rgos" "$NEWROOT/var/lib/rgos"
fi

# boot files: write to name.new, then rename (falls back to a plain overwrite when the FAT partition is too full)
put() {
    if cp "$1" "$2.new" 2>/dev/null && sync && mv -f "$2.new" "$2"; then return 0; fi
    rm -f "$2.new"
    cp "$1" "$2" && sync
}
say "installing kernel, initramfs and device tree"
mkdir -p "$BOOT/extlinux"
for x in Image initrd.gz rgos.dtb; do
    put "$TMP/boot/$x" "$BOOT/$x" || fail_keep "could not write $BOOT/$x"
done
put "$TMP/boot/extlinux/extlinux.conf" "$BOOT/extlinux/extlinux.conf" || fail_keep "could not write extlinux.conf"
[ "$HAVE_BI" = 0 ] || put "$TMP/boot/boot.img" "$BOOT/boot.img" || fail_keep "could not write $BOOT/boot.img"

# the release marker is written LAST: if power fails earlier, the next boot sees the old/no build id and retries
printf 'BUILD_ID=%s\n' "$new" > "$NEWROOT/etc/rgos-release"
sync
consume
say "update to build $new installed - $name deleted"
cleanup
exit 0
