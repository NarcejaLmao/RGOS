#!/bin/bash
# Build the splash video that ships with RG OS (overlay/etc/rgos/splash/) from a 16:9 source video:
#
#   tools/make-shipped-splash rgos_splash_16x9.mp4
#
#   rg34xx-sp (720x480, 3:2) <- the 16:9 video, fitted to the full width with thin black bars above and below
# The sound (splash.wav) comes from the same video. Needs ffmpeg; uses tools/make-splash for the conversion.
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
SRC=$1
[ -f "$SRC" ] || { sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
OUT="$HERE/../overlay/etc/rgos/splash"
mkdir -p "$OUT"; rm -f "$OUT"/splash*
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT
dev=rg34xx-sp
"$HERE/make-splash" "$SRC" "$dev" "$TMP/$dev" >/dev/null
cp "$TMP/$dev/splash.mjpg" "$OUT/splash-$dev.mjpg"
python3 - "$TMP/$dev/splash.json" "$OUT/splash-$dev.json" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
json.dump(c, open(sys.argv[2], "w"))
PY
cp "$TMP/$dev/splash.wav" "$OUT/splash.wav" 2>/dev/null || true
echo "$dev: $(du -k "$OUT/splash-$dev.mjpg" | cut -f1) KB"
ls -l "$OUT"
