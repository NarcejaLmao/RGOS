#!/bin/bash
# Turn any video into an RG OS startup splash (needs ffmpeg, run it on a PC).
#
#   tools/make-splash my-intro.mp4 rg34xx-sp          # sized for the device (720x480)
#   tools/make-splash my-intro.mp4 640x480 out-dir    # or any size, and a different output folder (default: ./splash)
#
# Writes splash.mjpg (the video), splash.json (frame rate) and splash.wav (its sound, only if the video has audio) into the
# output folder. Copy that whole folder to the ROMS card as  splash/  - it overrides the video that ships with RG OS and
# survives firmware updates. Delete the folder to go back to the built-in one.
# Limits: 8 s, 24 fps, no sound longer than the video. A video of another aspect ratio is fitted with black bars.
set -e
IN=$1; DEV=${2:-}; OUT=${3:-splash}
[ -f "$IN" ] && [ -n "$DEV" ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
case "$DEV" in
  rg34xx-sp) SIZE=720x480;;
  [0-9]*x[0-9]*) SIZE=$DEV;;
  *) echo "unknown device/size: $DEV"; exit 1;;
esac
W=${SIZE%x*}; H=${SIZE#*x}; FPS=24
command -v ffmpeg >/dev/null || { echo "ffmpeg not found (sudo apt install ffmpeg)"; exit 1; }
mkdir -p "$OUT"
ffmpeg -y -v error -t 8 -i "$IN" -an -pix_fmt yuvj420p -q:v 4 -f mjpeg \
  -vf "fps=$FPS,scale=$W:$H:force_original_aspect_ratio=decrease,pad=$W:$H:(ow-iw)/2:(oh-ih)/2:black" "$OUT/splash.mjpg"
printf '{"fps": %d, "sound": "splash.wav", "width": %d, "height": %d}\n' "$FPS" "$W" "$H" > "$OUT/splash.json"
rm -f "$OUT/splash.wav"
if ffprobe -v error -select_streams a -show_entries stream=codec_type -of csv=p=0 "$IN" | grep -q audio; then
  ffmpeg -y -v error -t 8 -i "$IN" -vn -ac 1 -ar 22050 -c:a pcm_s16le "$OUT/splash.wav"
fi
echo "wrote $OUT/: $(ls -1 "$OUT" | tr '\n' ' ')  ($(du -k "$OUT/splash.mjpg" | cut -f1) KB video) - copy the folder to the ROMS card as splash/"
