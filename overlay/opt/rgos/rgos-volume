#!/usr/bin/env python3
"""RG OS volume daemon: VOL+/VOL- buttons (KEY_VOLUMEUP/KEY_VOLUMEDOWN from gpio-keys-volume) -> ALSA mixer.

Runs as its own service so the buttons work in the menu and in-game. Volume is kept as one 0-100 value, applied to
every playback mixer control that exists from CONTROLS, persisted in /var/lib/rgos/volume and mirrored to
/run/rgos/volume (the menu shows a popup when that file changes).
In-game, the level is shown by RetroArch itself: the daemon sends "SHOW_MSG ..." to RetroArch's UDP network command
port (network_cmd_enable in /etc/rgos/retroarch.cfg), so it appears on top of the game.
Override in /etc/rgos/volume.conf (KEY=VALUE): CONTROLS="Line Out,Headphone"  STEP=5  DEFAULT=60  CARD=0
  OSD_PORT=55355 (0 = no in-game message)  CARD=auto (first non-HDMI sound card)  FIRST_ONLY=1 (set only the first control
  found, for codecs where several volume stages in series would square the attenuation)
/etc/rgos/volume-<device>.conf (device = /etc/rgos-device) is read after volume.conf.
While rgos-hw runs (it creates /run/rgos/hw-active) the volume keys are ignored while SELECT is held: SELECT+VOL changes
the brightness instead.
"""
import os, re, socket, subprocess, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from evpad import EvPads, EV_KEY

KEY_VOLDOWN, KEY_VOLUP = 114, 115
CONF, SAVED, SHOWN = "/etc/rgos/volume.conf", "/var/lib/rgos/volume", "/run/rgos/volume"
BTN_SELECT, HW_ACTIVE = 0x13a, "/run/rgos/hw-active"
cfg = {"CONTROLS": "Line Out,Speaker,Headphone,Master", "STEP": "5", "DEFAULT": "60", "CARD": "0", "OSD_PORT": "0",
       "FIRST_ONLY": "0"}
try:
    DEVICE = open("/etc/rgos-device").read().strip()
except OSError:
    DEVICE = "rg34xx-sp"
for _path in (CONF, "/etc/rgos/volume-%s.conf" % DEVICE):
    try:
        for line in open(_path):
            m = re.match(r'\s*([A-Z_]+)\s*=\s*"?([^"#\n]*)"?', line)
            if m:
                cfg[m.group(1)] = m.group(2).strip()
    except OSError:
        pass
STEP = max(1, int(cfg["STEP"]))
if cfg["CARD"] == "auto":
    import hwctl
    CARD = str(hwctl.audio_card())
else:
    CARD = cfg["CARD"]
FIRST_ONLY = cfg["FIRST_ONLY"] not in ("0", "", "false", "no")
OSD_PORT = int(cfg["OSD_PORT"] or 0)
WANT = [c.strip() for c in cfg["CONTROLS"].split(",") if c.strip()]


def amixer(*args):
    try:
        return subprocess.run(["amixer", "-c", CARD, *args], capture_output=True, text=True, timeout=5).stdout
    except Exception:
        return ""


def find_controls():
    """Playback controls (with volume) that exist on the card, in CONTROLS order."""
    have = set(re.findall(r"Simple mixer control '([^']+)',0", amixer("scontrols")))
    found = [c for c in WANT if c in have]
    if FIRST_ONLY:
        found = found[:1]
    if not found:        # unknown codec naming: fall back to the first control that has a playback volume
        for name in sorted(have):
            if "pvolume" in amixer("sget", name).lower() and "capture" not in name.lower():
                found = [name]
                break
    return found


def read_saved():
    try:
        return max(0, min(100, int(open(SAVED).read().strip())))
    except (OSError, ValueError):
        return max(0, min(100, int(cfg["DEFAULT"])))


def write(path, text):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as f:
            f.write(text)
    except OSError:
        pass


_sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)


def osd(vol):
    """On-screen message inside a running RetroArch (harmless if RetroArch is not running)."""
    if not OSD_PORT:
        return
    filled = (vol + 5) // 10
    msg = "SHOW_MSG Volume %3d%%  [%s%s]" % (vol, "#" * filled, "-" * (10 - filled))
    try:
        _sock.sendto(msg.encode(), ("127.0.0.1", OSD_PORT))
    except OSError:
        pass


def apply(vol, controls):
    ok = False
    for c in controls:
        amixer("-q", "sset", c, "%d%%" % vol, "unmute" if vol else "mute")
        ok = True
    return ok


def main():
    vol, controls, applied = read_saved(), [], False
    pads, next_retry, select_held = EvPads(), 0.0, False
    osd_due, osd_last = False, 0.0       # throttled: holding a button must not flood RetroArch with messages
    while True:
        now = time.time()
        if not applied and now >= next_retry:      # the sound card can show up late after boot
            controls = find_controls()
            applied = bool(controls) and apply(vol, controls)
            next_retry = now + 3.0
            if applied:
                write(SHOWN, "%d %d" % (vol, now))
        delta = 0
        for t, c, v in pads.read():
            if t == EV_KEY and c == BTN_SELECT:
                select_held = v != 0
            elif t == EV_KEY and v in (1, 2):       # press or autorepeat
                if select_held and os.path.exists(HW_ACTIVE):
                    continue                        # SELECT+VOL = brightness (rgos-hw)
                if c == KEY_VOLUP:
                    delta += STEP
                elif c == KEY_VOLDOWN:
                    delta -= STEP
        if delta:
            vol = max(0, min(100, vol + delta))
            if not applied:
                controls = find_controls()
            applied = bool(controls) and apply(vol, controls)
            write(SAVED, str(vol))
            write(SHOWN, "%d %d" % (vol, time.time() * 1000))
            osd_due = True
        if osd_due and time.time() - osd_last >= 0.25:
            osd(vol)
            osd_due, osd_last = False, time.time()
        time.sleep(0.03)


if __name__ == "__main__":
    main()
