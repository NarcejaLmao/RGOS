# ---------------------------------------------------------------- ioctl helpers
def _ioc(d, t, nr, size):
    return (d << 30) | (size << 16) | (ord(t) << 8) | nr
_IOW = lambda t, nr, size: _ioc(1, t, nr, size)
_IOR = lambda t, nr, size: _ioc(2, t, nr, size)
_IOWR = lambda t, nr, size: _ioc(3, t, nr, size)

EVIOCGRAB = _IOW("E", 0x90, 4)
EVIOCGNAME = _IOR("E", 0x06, 128)
EVIOCGBIT_ABS = _IOR("E", 0x20 + 3, 8)       # ABS_MAX = 0x3f -> 8 bytes
EVIOCGABS = lambda a: _IOR("E", 0x40 + a, 24)  # struct input_absinfo: value, min, max, fuzz, flat, resolution
EVIOCGBIT_KEY = _IOR("E", 0x20 + EV_KEY, 96)  # KEY_MAX = 0x2ff -> 96 bytes of bitmap
UI_DEV_CREATE, UI_DEV_DESTROY = _ioc(0, "U", 1, 0), _ioc(0, "U", 2, 0)
UI_DEV_SETUP, UI_ABS_SETUP = _IOW("U", 3, 92), _IOW("U", 4, 28)
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_ABSBIT = _IOW("U", 100, 4), _IOW("U", 101, 4), _IOW("U", 103, 4)
UI_SET_FFBIT = _IOW("U", 107, 4)
EV_FF, FF_RUMBLE = 0x15, 0x50
GPIO_GET_CHIPINFO = _IOR("\xb4", 0x01, 68)
GPIO_V2_GET_LINE = _IOWR("\xb4", 0x07, 592)
GPIO_V2_SET_VALUES = _IOWR("\xb4", 0x0F, 16)
GPIO_V2_LINE_FLAG_OUTPUT = 1 << 3


def log(*a):
    print(time.strftime("%H:%M:%S"), *a, flush=True)


def load_conf():
    try:
        with open(CONF) as f:
            c = json.load(f).get("sticks", {})
        return c if isinstance(c, dict) else {}
    except Exception:
        return {}


# ---------------------------------------------------------------- device-tree wiring
def dt_u32(name):
    try:
        with open(os.path.join(DT, name), "rb") as f:
            d = f.read()
        return list(struct.unpack(">%dI" % (len(d) // 4), d[:len(d) // 4 * 4]))
    except OSError:
        return None


def dt_flag(name):
    return os.path.exists(os.path.join(DT, name))


def load_mapfile():
    """Axis mapping saved by the menu's calibration wizard: {"map": [axis for each mux position], "invert": [X,Y,RX,RY]}."""
    try:
        with open(MAPFILE) as f:
            d = json.load(f)
        m, inv = d.get("map"), d.get("invert")
        if isinstance(m, list) and sorted(m) == [0, 1, 2, 3] and isinstance(inv, list) and len(inv) == 4:
            return [int(x) for x in m], [bool(x) for x in inv]
    except Exception:
        pass
    return None, None


class Wiring:
    """Mux select lines, GPADC channel, axis mapping and inversion. DTB values, with the RG34XX-SP defaults as fallback."""
    def __init__(self, conf):
        a, b = dt_u32("amux-a-gpios") or [0, 8, 1, 1], dt_u32("amux-b-gpios") or [0, 8, 2, 1]
        # <&pio bank pin flags>; sunxi gpiochip line offset = bank * 32 + pin; flag bit0 = active low
        self.lines = [a[1] * 32 + a[2], b[1] * 32 + b[2]]
        self.active_low = [bool(a[3] & 1), bool(b[3] & 1)]
        io = dt_u32("io-channels")
        self.channel = io[1] if io and len(io) >= 2 else 0
        n = (dt_u32("amux-count") or [4])[0]
        self.count = n if n in (2, 4) else 4
        saved_map, saved_inv = load_mapfile()
        m = conf.get("mux_map") or saved_map or dt_u32("amux-channel-mapping") or [0, 2, 1, 3]
        self.map = [int(x) % 4 for x in m][:self.count]
        while len(self.map) < self.count:
            self.map.append(len(self.map))
        inv = conf.get("invert")
        if not (isinstance(inv, list) and len(inv) == 4):
            inv = saved_inv if saved_inv and not conf.get("mux_map") else None
        if not (isinstance(inv, list) and len(inv) == 4):
            inv = [dt_flag("invert-abs" + n) if os.path.isdir(DT) else True for n in ("x", "y", "rx", "ry")]
        self.invert = [bool(x) for x in inv]
        self.chip_path = conf.get("gpio_chip")
        self.iio_dir = conf.get("iio_dir")


# ---------------------------------------------------------------- hardware: mux GPIOs + GPADC
class Mux:
    """The two mux select lines, requested as outputs through the GPIO v2 character device."""
    def __init__(self, wiring):
        self.w, self.fd, self.state = wiring, -1, None
        path = wiring.chip_path or self._find_chip()
        chip = os.open(path, os.O_RDWR | os.O_CLOEXEC)
        try:
            req = bytearray(592)
            for i, off in enumerate(wiring.lines):
                struct.pack_into("<I", req, 4 * i, off)
            req[256:256 + 8] = b"rgos-mux"
            struct.pack_into("<Q", req, 288, GPIO_V2_LINE_FLAG_OUTPUT)    # config.flags
            struct.pack_into("<I", req, 560, len(wiring.lines))           # num_lines
            fcntl.ioctl(chip, GPIO_V2_GET_LINE, req)
            self.fd = struct.unpack_from("<i", req, 588)[0]
        finally:
            os.close(chip)
        if self.fd < 0:
            raise OSError(errno.EIO, "gpio line request returned no fd")
        self.select(0)

    @staticmethod
    def _find_chip():
        for p in sorted(glob.glob("/dev/gpiochip*")):
            try:
                fd = os.open(p, os.O_RDONLY | os.O_CLOEXEC)
            except OSError:
                continue
            try:
                buf = bytearray(68)
                fcntl.ioctl(fd, GPIO_GET_CHIPINFO, buf)
                label = bytes(buf[32:64]).split(b"\0")[0].decode(errors="replace")
            except OSError:
                continue
            finally:
                os.close(fd)
            if "300b000" in label:                 # the H700 main pin controller (banks PA..PI)
                return p
        raise OSError(errno.ENODEV, "no gpiochip labelled 300b000.pinctrl")

    def select(self, sel):
        if sel == self.state:
            return
        bits = 0
        for i in range(len(self.w.lines)):
            level = (sel >> i) & 1                  # logical value; line a = bit 0, line b = bit 1
            if level ^ self.w.active_low[i]:        # -> physical level
                bits |= 1 << i
        fcntl.ioctl(self.fd, GPIO_V2_SET_VALUES, bytearray(struct.pack("<QQ", bits, (1 << len(self.w.lines)) - 1)))
        self.state = sel

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1


class Adc:
    """GPADC channel through IIO sysfs (in_voltageN_raw)."""
    def __init__(self, wiring):
        d = wiring.iio_dir
        if not d:
            for cand in sorted(glob.glob("/sys/bus/iio/devices/iio:device*")):
                real, name = os.path.realpath(cand), ""
                try:
                    with open(cand + "/name") as f:
                        name = f.read().strip()
                except OSError:
                    pass
                if "5070000" in real or "5070000" in name or "gpadc" in name:
                    d = cand
                    break
        if not d:
            raise OSError(errno.ENODEV, "no GPADC iio device (is the sun20i-gpadc-iio driver loaded?)")
        raw = "%s/in_voltage%d_raw" % (d, wiring.channel)
        if not os.path.exists(raw):
            raise OSError(errno.ENOENT, "%s missing" % raw)
        self.path, self.fd = raw, os.open(raw, os.O_RDONLY | os.O_CLOEXEC)

    def read(self):
        return int(os.pread(self.fd, 32, 0))

    def close(self):
        os.close(self.fd)


# ---------------------------------------------------------------- calibration + sampling
class Sticks:
    MIN_HALF = 150

    def __init__(self, conf):
        self.conf = conf
        self.w = Wiring(conf)
        self.settle = float(conf.get("settle_us", 400)) / 1e6
        self.dead = min(0.5, max(0.0, float(conf.get("deadzone", 0.10))))
        self.mux = self.adc = None
        self.hist = [[], [], [], []]
        self.cal = [None] * 4                       # [lo, hi, center] per axis
        self.last = [0] * 4
        self.raw = [0] * 4
        self.pos = [0] * 4                          # latest raw ADC value per mux select position (for the wizard)
        self.dirty, self.saved = False, time.time()

    def open(self):
        self.mux, self.adc = Mux(self.w), Adc(self.w)
        # centre = sticks at rest right now (median of a few passes); a stored calibration keeps its learned
        # extremes, and its centre unless the sticks were obviously held at power-on
        rest = [[], [], [], []]
        for _ in range(15):
            r = self.sample()
            for i in range(4):
                rest[i].append(r[i])
        c0 = [sorted(v)[len(v) // 2] for v in rest]
        stored = self._load()
        for i in range(4):
            if stored and stored[i]:
                lo, hi, c = stored[i]
                half = max(hi - c, c - lo, self.MIN_HALF)
                if abs(c0[i] - c) <= 0.25 * half:
                    c = c0[i]
                self.cal[i] = [min(lo, c - self.MIN_HALF), max(hi, c + self.MIN_HALF), c]
            else:
                h = max(250, int(0.18 * c0[i]))
                self.cal[i] = [c0[i] - h, c0[i] + h, c0[i]]
        self.hist = [[c0[i]] * 3 for i in range(4)]
        self.raw = list(c0)
        log("sticks: adc %s, mux gpio offsets %s (active_low %s), map %s, invert %s, centres %s" % (
            self.adc.path, self.w.lines, self.w.active_low, self.w.map, self.w.invert, c0))

    def _load(self):
        try:
            with open(CAL) as f:
                a = json.load(f)["axes"]
            return [tuple(int(x) for x in (e["lo"], e["hi"], e["center"])) if e else None for e in a][:4]
        except Exception:
            return None

    def save(self, force=False):
        if not (self.dirty or force) or any(c is None for c in self.cal):
            return
        try:
            os.makedirs(os.path.dirname(CAL), exist_ok=True)
            tmp = CAL + ".tmp"
            with open(tmp, "w") as f:
                json.dump({"axes": [{"lo": c[0], "hi": c[1], "center": c[2]} for c in self.cal]}, f)
            os.replace(tmp, CAL)
            self.dirty, self.saved = False, time.time()
        except OSError as e:
            log("sticks: cannot save calibration:", e)

    def sample(self):
        """One pass over the mux: raw ADC value per axis index."""
        out = [0] * 4
        for sel in range(self.w.count):
            self.mux.select(sel)
            if self.settle:
                time.sleep(self.settle)
            v = self.adc.read()
            if sel < 4:
                self.pos[sel] = v
            out[self.w.map[sel] if self.w.map[sel] < 4 else sel] = v
        return out

    def norm(self, i, raw):
        lo, hi, c = self.cal[i]
        if raw < lo:
            self.cal[i][0], self.dirty = raw, True
            lo = raw
        elif raw > hi:
            self.cal[i][1], self.dirty = raw, True
            hi = raw
        d = raw - c
        half = max((hi - c) if d > 0 else (c - lo), self.MIN_HALF)
        v = max(-1.0, min(1.0, d / half))
        a = abs(v)
        a = 0.0 if a < self.dead else min(1.0, (a - self.dead) / (0.95 - self.dead))   # dead zone + reach 100% a bit early
        v = a if v > 0 else -a
        return -v if self.w.invert[i] else v

    def poll(self):
        """Sample once; returns [(abs_code, value), ...] for the axes that changed."""
        raw = self.sample()
        ev = []
        for i in range(4):
            h = self.hist[i]
            h.pop(0)
            h.append(raw[i])
            self.raw[i] = sorted(h)[1]              # median of 3: kills single-sample spikes (mux settling)
            val = int(round(self.norm(i, self.raw[i]) * AMAX))
            if val != self.last[i] and (abs(val - self.last[i]) >= 300 or val == 0 or abs(val) >= AMAX - 300):
                self.last[i] = val
                ev.append((ABS_CODES[i], val))
        if self.dirty and time.time() - self.saved > 30:
            self.save()
        return ev

    def close(self):
        self.save()
        for o in (self.mux, self.adc):
            try:
                o and o.close()
            except OSError:
                pass


# ---------------------------------------------------------------- input devices
def find_raw_event():
    for p in sorted(glob.glob("/sys/class/input/event*")):
        try:
            with open(p + "/device/name") as f:
                if f.read().strip() == RAW_NAME:
                    return "/dev/input/" + os.path.basename(p)
        except OSError:
            continue
    return None


def key_codes(fd):
    buf = bytearray(96)
    fcntl.ioctl(fd, EVIOCGBIT_KEY, buf)
    return [i for i in range(96 * 8) if buf[i >> 3] >> (i & 7) & 1]


def make_uinput(codes, ff=False):
    fd = None
    for p in ("/dev/uinput", "/dev/input/uinput"):
        try:
            fd = os.open(p, os.O_RDWR | os.O_NONBLOCK | os.O_CLOEXEC)
            break
        except OSError:
            continue
    if fd is None:
        raise OSError(errno.ENODEV, "no /dev/uinput (kernel without INPUT_UINPUT?)")
    try:
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
        for c in codes:
            fcntl.ioctl(fd, UI_SET_KEYBIT, c)
        fcntl.ioctl(fd, UI_SET_EVBIT, EV_ABS)
        for c in ABS_CODES:
            fcntl.ioctl(fd, UI_SET_ABSBIT, c)
        if ff:                                  # rumble: RetroArch / SDL upload FF_RUMBLE effects to this pad (see ffpad.py)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_FF)
            fcntl.ioctl(fd, UI_SET_FFBIT, FF_RUMBLE)
        # bus HOST(0x19), vendor 'HK' (0x484b) / product 0x14df / version 0x100 = joypad-vendor/product/revision of the DTB;
        # last field = ff_effects_max
        fcntl.ioctl(fd, UI_DEV_SETUP, struct.pack("<HHHH80sI", 0x19, 0x484B, 0x14DF, 0x100, HUB_NAME.encode(), 16 if ff else 0))
        for c in ABS_CODES:
            fcntl.ioctl(fd, UI_ABS_SETUP, struct.pack("<HHiiiiii", c, 0, 0, -AMAX, AMAX, 0, 0, 0))
        fcntl.ioctl(fd, UI_DEV_CREATE)
    except OSError:
        os.close(fd)
        raise
    return fd


def udev_refresh():
    """Re-run the udev rules for input devices (they hide the raw pad only while FLAG exists)."""
    try:
        subprocess.run(["udevadm", "control", "--reload"], timeout=10)
        subprocess.run(["udevadm", "trigger", "--action=change", "--subsystem-match=input"], timeout=10)
        subprocess.run(["udevadm", "settle", "--timeout=5"], timeout=10)
    except Exception as e:
        log("udevadm failed:", e)


def write_status(text):
    try:
        os.makedirs(os.path.dirname(STATUS), exist_ok=True)
        with open(STATUS + ".tmp", "w") as f:
            f.write(text + "\n")
        os.replace(STATUS + ".tmp", STATUS)
    except OSError:
        pass


# ---------------------------------------------------------------- main loop
STOP = False


def _stop(*_):
    global STOP
    STOP = True


def load_input_conf(conf=CONF, devfile="/etc/rgos-device", etc="/etc/rgos"):
    """input.json merged with /etc/rgos/input-<device>.json (top-level keys replace, the "sticks" object is merged)."""
    out = {}
    try:
        with open(conf) as f:
            out = json.load(f)
        if not isinstance(out, dict):
            out = {}
    except Exception:
        out = {}
    try:
        with open(devfile) as f:
            dev = f.read().strip()
        with open("%s/input-%s.json" % (etc, dev)) as f:
            extra = json.load(f)
        st = dict(out.get("sticks") or {})
        st.update(extra.get("sticks") or {})
        out.update(extra)
        out["sticks"] = st
    except Exception:
        pass
    return out


def load_keymap(iconf):
    """{(device name or None, type, code, sign): canonical code}. Sources: input.json "keymap" (any device, plain key
    codes) and the wizard's button-map.json ({"keys": {"<name>|<type>:<code>:<sign>": canonical}})."""
    km = {}
    for k, v in (iconf.get("keymap") or {}).items():
        try:
            km[(None, 1, int(str(k), 0), 0)] = int(str(v), 0)
        except ValueError:
            pass
    try:
        with open(BTNMAP) as f:
            for k, v in (json.load(f).get("keys") or {}).items():
                name, _, rest = k.rpartition("|")
                t, c, sg = rest.split(":")
                km[(name or None, int(t), int(c), int(sg))] = int(v)
    except Exception:
        pass
    return km


class Translator:
    """Turns raw source events into events of the canonical pad (pure logic, no I/O)."""
    def __init__(self, keymap=None, axis_map=None, invert=None, dead=0.10, legacy=False, auto_map=True):
        self.keymap, self.axis_map, self.legacy = keymap or {}, axis_map or {}, legacy
        self.auto_map = bool(auto_map)
        self.invert = list(invert) if invert else [False] * 4
        self.dead = min(0.5, max(0.0, dead))
        self.astate, self.last = {}, [0] * 4
        self.explicit_axes = bool(axis_map)         # an axis_map from input.json beats the per-device guess
        self.prof = {}                              # device name -> {"keys": {code: canon}, "axes": {...}, "trig": {...}}

    def learn(self, name, keys, axes):
        """Profile one source from its capability bits (`keys` / `axes` = sets of codes) and say what was decided."""
        notes, kmap = [], {}
        if self.auto_map and not self.legacy:
            known = {c for c in keys if (name, 1, c, 0) in self.keymap or (None, 1, c, 0) in self.keymap
                     or c in CANON_KEYS or c in AUTO_KEY_ALIASES or c in EXTRA_KEYS}
            pad_keys = sorted(c for c in keys if c in GAMEPAD_KEY_RANGE)
            if pad_keys and not (known & set(pad_keys)):
                # nothing recognisable among the gamepad-range buttons: assign them in code order
                for c, canon in zip(pad_keys, ORDERED_FILL):
                    kmap[c] = canon
                notes.append("buttons: unknown codes, assigned in order %s" % ", ".join(
                    "0x%x->0x%x" % (c, kmap[c]) for c in pad_keys[:len(ORDERED_FILL)]))
            elif known:
                notes.append("buttons: %d recognised" % len(known))
            # a device that has BOTH gamepad-style and keyboard-style codes keeps the gamepad ones
            if set(pad_keys) & set(CANON_KEYS):
                kmap.update({c: None for c in keys if c in AUTO_KEY_ALIASES and c < 0x100 and c not in (103, 105, 106, 108)})
        amap, trig = dict(SRC_AXES), {}
        if self.auto_map and not self.explicit_axes:
            if axes & {0x03, 0x04}:                 # a real second stick exists: Z/RZ (or GAS/BRAKE) are the triggers
                amap = {0x00: 0, 0x01: 1, 0x03: 2, 0x04: 3}
                trig = {c: TRIGGER_AXES[c] for c in (0x02, 0x05, 0x09, 0x0a) if c in axes}
            elif axes & {0x09, 0x0a}:
                trig = {c: TRIGGER_AXES[c] for c in (0x09, 0x0a) if c in axes}
                amap = {k: v for k, v in SRC_AXES.items() if k not in (0x09, 0x0a)}
        elif self.explicit_axes:
            amap = dict(self.axis_map)
        self.prof[name] = {"keys": kmap, "axes": amap, "trig": trig}
        sticks = sorted(c for c in amap if c in axes)
        notes.append("axes: %s%s" % (",".join("0x%x->%s" % (c, AXIS_NAMES[amap[c]]) for c in sticks) or "none",
                                     ("; triggers " + ",".join("0x%x->0x%x" % kv for kv in trig.items())) if trig else ""))
        return notes

    def key(self, name, code, value):
        t = self.keymap.get((name, 1, code, 0)) or self.keymap.get((None, 1, code, 0))
        pk = self.prof.get(name, {}).get("keys", {})
        if t is None and code in pk:
            if pk[code] is None:
                return []                           # shadowed keyboard-style code on a device that also has gamepad codes
            t = pk[code]
        if t is None and self.auto_map:
            t = AUTO_KEY_ALIASES.get(code)
        if t is None and (self.legacy or code in CANON_KEYS or code in EXTRA_KEYS):
            t = code
        return [(EV_KEY, t, value)] if t is not None else []

    def abs(self, name, code, value, rng):
        """rng = (min, max) of the source axis."""
        out = []
        lo, hi = rng
        if hi <= lo:
            lo, hi = -AMAX, AMAX
        mid, half = (lo + hi) / 2.0, max((hi - lo) / 2.0, 1.0)
        for sign in (-1, 1):                              # ABS used as a button (hat, digital pad, trigger)
            canon = self.keymap.get((name, 3, code, sign)) or self.keymap.get((None, 3, code, sign)) or HAT_KEYS.get((code, sign))
            if canon is None:
                continue
            on = (value - mid) * sign >= 0.6 * half
            k = (name, code, sign)
            if self.astate.get(k, False) != on:
                self.astate[k] = on
                out.append((EV_KEY, canon, 1 if on else 0))
        prof = self.prof.get(name)
        trig = prof["trig"].get(code) if prof else None
        if trig is not None:                                # analog trigger -> L2/R2 button (on past half travel)
            on = value >= lo + 0.5 * (hi - lo)
            k = (name, code, 2)
            if self.astate.get(k, False) != on:
                self.astate[k] = on
                out.append((EV_KEY, trig, 1 if on else 0))
            return out
        ax = (prof["axes"] if prof else self.axis_map).get(code)
        if ax is not None:
            v = max(-1.0, min(1.0, (value - mid) / half))
            a = abs(v)
            a = 0.0 if a < self.dead else min(1.0, (a - self.dead) / (0.95 - self.dead))
            v = -a if v < 0 else a
            if self.invert[ax]:
                v = -v
            val = int(round(v * AMAX))
            last = self.last[ax]
            if val != last and (abs(val - last) >= 300 or val == 0 or abs(val) >= AMAX - 300):
                self.last[ax] = val
                out.append((EV_ABS, ABS_CODES[ax], val))
        return out


class Source:
    """One physical input device that feeds the hub."""
    def __init__(self, path, name):
        self.path, self.name = path, name
        self.fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
        self.rng = {}
        self.grabbed = False

    def absrange(self, c):
        r = self.rng.get(c)
        if r is None:
            try:
                buf = bytearray(24)
                fcntl.ioctl(self.fd, EVIOCGABS(c), buf)
                _, mn, mx = struct.unpack_from("<3i", buf, 0)
                r = (mn, mx)
            except OSError:
                r = (-AMAX, AMAX)
            self.rng[c] = r
        return r

    def grab(self):
        try:
            fcntl.ioctl(self.fd, EVIOCGRAB, 1)
            self.grabbed = True
        except OSError as e:
            log("cannot grab %s (%s): %s (duplicate events possible)" % (self.path, self.name, e))

    def close(self):
        try:
            if self.grabbed:
                fcntl.ioctl(self.fd, EVIOCGRAB, 0)
        except OSError:
            pass
        try:
            os.close(self.fd)
        except OSError:
            pass


def _bits(fd, req, n):
    buf = bytearray(n)
    fcntl.ioctl(fd, req, buf)
    return {i for i in range(n * 8) if buf[i >> 3] >> (i & 7) & 1}


_REJECTED = {}


def _reject(path, name, why):
    """Say once (per device and reason) why a device is NOT used, so the log shows what the hub saw."""
    if _REJECTED.get(path) != why:
        _REJECTED[path] = why
        log("input skipped %s (%s): %s" % (path, name, why))


def scan_sources(spec, have):
    """Event devices to merge. spec: "auto" or a list of name substrings. `have` = paths already open."""
    found = []
    for ev in sorted(glob.glob("/sys/class/input/event*")):
        path = "/dev/input/" + os.path.basename(ev)
        if path in have:
            continue
        try:
            with open(ev + "/device/name") as f:
                name = f.read().strip()
        except OSError:
            continue
        if name == HUB_NAME:
            continue
        if spec == "auto":
            low = name.lower()
            if any(x in low for x in NOT_PADS):
                _reject(path, name, "name is a power/volume/lid/jack/touch device")
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC)
            except OSError as e:
                _reject(path, name, "cannot open: %s" % e)
                continue
            try:
                keys, axes = _bits(fd, EVIOCGBIT_KEY, 96), _bits(fd, EVIOCGBIT_ABS, 8)
            except OSError as e:
                _reject(path, name, "capability ioctl failed: %s" % e)
                continue
            finally:
                os.close(fd)
            # Accept: standard pad codes; joystick-range buttons with axes/hat/a pad-like name; stick axes with a pad-like
            # name; and keyboard-style handhelds (the TSP's vendor input path may look like a few KEY_* codes: D-pad keys
            # and/or the SPACE/CTRL/SHIFT/ALT/ENTER/ESC layout). A real keyboard is told apart by its many letter keys.
            gamepad_keys = keys.intersection(GAMEPAD_KEY_RANGE)
            has_stick_axes = bool(axes.intersection({0, 1, 2, 3, 4, 5, 6, 7}))
            has_hat = bool(axes.intersection({0x10, 0x11}))
            lname = name.lower()
            gamepad_name = any(word in lname for word in ("gamepad", "joystick", "joypad", "controller", "gpio-keys", "trimui", "player1"))
            letters = len(keys.intersection(range(16, 50)))          # KEY_Q..KEY_SLASH region: a real keyboard has nearly all
            # Some TrimUI Smart Pro kernels expose the controls as a sparse keyboard
            # device (often only D-pad + a few action keys), rather than a joystick.
            # Requiring five keys from the legacy layout missed these devices entirely.
            dpad = keys.intersection({103, 105, 106, 108})
            handheld_actions = keys.intersection(KBD_PAD_KEYS - {103, 105, 106, 108})
            sparse_handheld = len(dpad) >= 2 and bool(handheld_actions) and letters < 20
            kbd_pad = (len(keys.intersection(KBD_PAD_KEYS)) >= 5 or len(dpad) == 4 or sparse_handheld) and letters < 20
            why = None
            if keys.intersection(CANON_KEYS):
                why = "standard pad buttons"
            elif gamepad_keys and (has_stick_axes or has_hat or gamepad_name):
                why = "joystick-range buttons"
            elif has_stick_axes and any(word in lname for word in ("joy", "gamepad", "controller")):
                why = "stick axes + pad-like name"
            elif kbd_pad:
                why = "keyboard-style handheld buttons"
            if why is None:
                _reject(path, name, "no pad buttons/axes (keys=%d letters=%d axes=%s)" % (
                    len(keys), letters, ",".join("0x%x" % a for a in sorted(axes)) or "none"))
                continue
            log("input candidate %s (%s): %s; buttons=%d axes=%s" %
                (path, name, why, len(keys), ",".join("0x%x" % a for a in sorted(axes)) or "none"))
        elif not any(sub in name for sub in spec):
            continue
        found.append((path, name))
    return found


def learn_source(translator, src):
    """Profile a source for auto-mapping and write what was decided to the log and /run/rgos/input-map.txt."""
    try:
        keys, axes = _bits(src.fd, EVIOCGBIT_KEY, 96), _bits(src.fd, EVIOCGBIT_ABS, 8)
    except OSError:
        keys, axes = set(), set()
    notes = translator.learn(src.name, keys, axes)
    line = "%s (%s): %s" % (src.path, src.name, "; ".join(notes))
    log("auto-map", line)
    try:
        with open(MAP_REPORT, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def write_rules(names):
    """Hide the grabbed sources from SDL/RetroArch (only the hub's merged pad should be a joystick)."""
    try:
        if not names:
            os.unlink(RULES)
            return
        os.makedirs(os.path.dirname(RULES), exist_ok=True)
        with open(RULES, "w") as f:
            for n in sorted(set(names)):
                q = n.replace("\\", "\\\\").replace('"', '\\"')
                f.write('SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="%s", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_KEY}="1"\n' % q)
    except OSError:
        pass


class KeyProbe:
    """While the menu's button wizard runs (flag file), publish the last raw key/hat/trigger press of any source."""
    def __init__(self):
        self.n, self.next_check, self.on = 0, 0.0, False

    def feed(self, src, t, c, v):
        now = time.time()
        if now >= self.next_check:
            self.next_check, self.on = now + 0.1, os.path.exists(KEYS_PROBE)
        if not self.on:
            return
        if t == EV_KEY and v == 1:
            sign = 0
        elif t == EV_ABS:
            lo, hi = src.absrange(c)
            mid, half = (lo + hi) / 2.0, max((hi - lo) / 2.0, 1.0)
            if abs(v - mid) < 0.6 * half:
                return
            sign = 1 if v > mid else -1
        else:
            return
        self.n += 1
        try:
            with open(KEYS_RAW + ".tmp", "w") as f:
                f.write("%d\t%s\t%d\t%d\t%d\n" % (self.n, src.name, t, c, sign))
            os.replace(KEYS_RAW + ".tmp", KEYS_RAW)
        except OSError:
            pass


def run():
    iconf = load_input_conf()
    conf = iconf.get("sticks") if isinstance(iconf.get("sticks"), dict) else {}
    signal.signal(signal.SIGTERM, _stop)
    signal.signal(signal.SIGINT, _stop)
    if conf.get("enabled") is False:
        write_status("hub: disabled in input.json")
        log("disabled in input.json; leaving the raw input devices alone")
        while not STOP:
            time.sleep(3600)
        return 0
    os.makedirs("/run/rgos", exist_ok=True)
    poll = max(0.004, float(conf.get("poll_ms", 10)) / 1000.0)
    has_dt = os.path.isdir(DT)
    mode = conf.get("mode") or ("adc-mux" if has_dt else "evdev")
    spec = iconf.get("sources") or ([RAW_NAME] if has_dt else "auto")
    legacy = spec == [RAW_NAME]                 # RG34XX-SP: publish exactly the raw pad's own key codes, as always
    if mode == "evdev":
        # Honor an explicit user mapping; otherwise accept the common alternate
        # Linux axis codes used by handheld BSP controller drivers.
        am = {int(str(k), 0): int(v) for k, v in
              (iconf.get("axis_map") or {str(k): v for k, v in SRC_AXES.items()}).items()}
        inv = conf.get("invert")
        translator = Translator(load_keymap(iconf), am, inv if isinstance(inv, list) and len(inv) == 4 else None,
                                float(conf.get("deadzone", 0.10)), legacy,
                                bool(iconf.get("auto_map_buttons", True)))
    else:
        translator = Translator(load_keymap(iconf), legacy=legacy,
                                auto_map=bool(iconf.get("auto_map_buttons", True)))
    translator.explicit_axes = bool(iconf.get("axis_map"))
    try:
        os.unlink(MAP_REPORT)
    except OSError:
        pass
    log("hub config: mode %s, sources %s, legacy codes %s, keymap entries %d, auto-map %s" %
        (mode, spec, legacy, len(translator.keymap), translator.auto_map))
    if mode == "evdev":
        log("axis map: %s; deadzone %.2f" % (am, translator.dead))

    # 1. the source devices (wait until at least one exists)
    srcs = {}
    while not STOP and not srcs:
        for path, name in scan_sources(spec, srcs):
            try:
                srcs[path] = Source(path, name)
            except OSError as e:
                log("cannot open %s: %s" % (path, e))
        if not srcs:
            write_status("hub: waiting for input devices (%s)" % (spec if spec == "auto" else ",".join(spec)))
            time.sleep(1)
    if STOP:
        return 0
    for x in srcs.values():
        learn_source(translator, x)
    first = next(iter(srcs.values()))
    codes = (sorted(set(key_codes(first.fd)) | set(translator.keymap.values())) if legacy
             else sorted(set(CANON_KEYS + EXTRA_KEYS) | set(translator.keymap.values())))
    log("sources: %s; %d key codes" % (", ".join("%s (%s)" % (x.path, x.name) for x in srcs.values()), len(codes)))

    # 2. the merged virtual pad (if this fails the source devices stay untouched)
    ff = motor = None                           # rumble only where /etc/rgos/hw-<device>.json asks for it and a motor exists
    try:
        import hwctl, ffpad
        hwc = hwctl.load_conf()
        if hwc and hwc.get("rumble", {}).get("ff", True):
            m = hwctl.Motor(hwc)
            motor = m if m.available else None
        log("rumble:", motor.describe() if motor else "off")
    except Exception as e:
        log("rumble support unavailable:", e)
    ufd, tries = None, 0
    while not STOP and ufd is None:
        try:
            ufd = make_uinput(codes, ff=motor is not None)
        except OSError as e:
            tries += 1
            if tries == 1:
                subprocess.run(["modprobe", "uinput"], stderr=subprocess.DEVNULL)
            write_status("hub: OFF, uinput: %s" % e)
            if tries == 1 or tries % 30 == 0:
                log("cannot create virtual pad:", e, "-> the menu still reads the raw devices; in-game input needs uinput in the kernel")
            time.sleep(2)
    if STOP:
        return 0
    if motor is not None:
        r_ = hwc.get("rumble", {})
        ff = ffpad.FFHandler(ufd, motor, float(r_.get("threshold", 0.15)), int(r_.get("max_ms", 3000)))
    for x in srcs.values():
        x.grab()
    open(FLAG, "w").close()
    write_rules([x.name for x in srcs.values()])
    udev_refresh()
    log("hub up: '%s'" % HUB_NAME)

    probe_keys = KeyProbe()
    sticks, next_try, last_status, note = None, 0.0, 0.0, ("sticks: starting" if mode == "adc-mux" else "sticks: %s" % mode)
    last_probe, probe_n, next_scan = 0.0, 0, time.time() + 3.0
    nxt = time.time()
    sleep_chk, asleep = 0.0, False
    try:
        while not STOP:
            now = time.time()
            if mode == "adc-mux" and sticks is None and now >= next_try:
                try:
                    s = Sticks(conf)
                    s.open()
                    sticks, note = s, "sticks: ok"
                except Exception as e:            # no GPADC yet / no GPIO chip: keep forwarding buttons, retry later
                    next_try, newnote = now + 5.0, "sticks: %s" % e
                    if newnote != note:
                        log(newnote)
                    note = newnote
                    try:
                        s.close()
                    except Exception:
                        pass
            if now >= next_scan:                  # devices that show up late (or come back) join the hub
                next_scan = now + 3.0
                if spec == "auto" or not srcs:
                    added = False
                    for path, name in scan_sources(spec, srcs):
                        try:
                            x = Source(path, name)
                        except OSError:
                            continue
                        learn_source(translator, x)
                        x.grab()
                        srcs[path] = x
                        added = True
                        log("source added: %s (%s)" % (path, name))
                    if added:
                        write_rules([x.name for x in srcs.values()])
                        udev_refresh()
            # wait for source events until the next stick sample is due
            wait = max(0.0, nxt - time.time()) if sticks else 0.25
            if ff is not None:
                wait = min(wait, ff.next_deadline())
            r, _, _ = select.select([x.fd for x in srcs.values()] + ([ufd] if ff is not None else []), [], [], wait)
            if ff is not None:
                if ufd in r:
                    ff.service()                  # answer FF uploads/erases, start/stop the motor
                else:
                    ff.tick()                     # an effect may just have run out
            out = bytearray()
            for x in list(srcs.values()):
                if x.fd not in r:
                    continue
                try:
                    data = os.read(x.fd, EVFMT.size * 64)
                except BlockingIOError:
                    continue
                except OSError as e:
                    log("source gone: %s (%s): %s" % (x.path, x.name, e))
                    x.close()
                    del srcs[x.path]
                    write_rules([y.name for y in srcs.values()])
                    udev_refresh()
                    if legacy and not srcs:
                        return 1
                    continue
                batch = []
                for off in range(0, len(data) - EVFMT.size + 1, EVFMT.size):
                    _, _, t, c, v = EVFMT.unpack_from(data, off)
                    if t in (EV_KEY, EV_ABS):
                        probe_keys.feed(x, t, c, v)
                    if t == EV_KEY:
                        batch += translator.key(x.name, c, v)
                    elif t == EV_ABS and mode != "none":
                        batch += translator.abs(x.name, c, v, x.absrange(c))
                    elif t == EV_SYN:
                        batch.append((EV_SYN, 0, 0))
                for t, c, v in batch:
                    out += EVFMT.pack(0, 0, t, c, v)
                if batch and batch[-1][0] != EV_SYN:
                    out += EVFMT.pack(0, 0, EV_SYN, 0, 0)
            if sticks is not None and time.time() >= nxt:
                if time.time() >= sleep_chk:                  # device asleep (rgos-hw): sample the sticks twice a second, not 100x
                    sleep_chk = time.time() + 0.25
                    asleep = os.path.exists("/run/rgos/sleeping")
                nxt = time.time() + (0.5 if asleep else poll)
                try:
                    ev = sticks.poll()
                except Exception as e:
                    log("stick read failed:", e)
                    sticks.close()
                    sticks, next_try, note = None, time.time() + 2.0, "sticks: read failed (%s)" % e
                    ev = []
                if sticks is not None and time.time() - last_probe >= 0.05:
                    last_probe = time.time()
                    if os.path.exists(PROBE_FLAG):        # the menu's stick wizard is watching the raw values
                        probe_n += 1
                        try:
                            with open(RAW_FILE + ".tmp", "w") as f:
                                f.write("%d %s\n" % (probe_n, " ".join(str(v) for v in sticks.pos)))
                            os.replace(RAW_FILE + ".tmp", RAW_FILE)
                        except OSError:
                            pass
                for c, v in ev:
                    out += EVFMT.pack(0, 0, EV_ABS, c, v)
                if ev:
                    out += EVFMT.pack(0, 0, EV_SYN, 0, 0)
            if out:
                try:
                    os.write(ufd, bytes(out))
                except OSError as e:
                    if e.errno != errno.EAGAIN:
                        log("uinput write failed:", e)
                        return 1
            if time.time() - last_status > 0.5:
                last_status = time.time()
                if sticks is not None:
                    write_status("hub:ok %s  L %+.2f %+.2f  R %+.2f %+.2f" % (
                        note, sticks.last[0] / AMAX, sticks.last[1] / AMAX, sticks.last[2] / AMAX, sticks.last[3] / AMAX))
                elif mode == "evdev":
                    la = translator.last
                    write_status("hub:ok src:%d evdev  L %+.2f %+.2f  R %+.2f %+.2f" % (
                        len(srcs), la[0] / AMAX, la[1] / AMAX, la[2] / AMAX, la[3] / AMAX))
                else:
                    write_status("hub:ok src:%d %s" % (len(srcs), note[:50]))
        return 0
    finally:
        try:
            if sticks:
                sticks.close()
            if ff is not None:
                ff.close()                        # motor off
            for x in srcs.values():
                x.close()
            fcntl.ioctl(ufd, UI_DEV_DESTROY)
        except OSError:
            pass
        for p in (FLAG, STATUS, RAW_FILE, KEYS_RAW, RULES, MAP_REPORT):
            try:
                os.unlink(p)
            except OSError:
                pass
        udev_refresh()


def probe():
    conf = load_conf()
    s = Sticks(conf)
    s.open()
    print("mux select -> axis map %s, invert %s   (Ctrl-C to stop)" % (s.w.map, s.w.invert))
    print("Move ONE stick at a time. Compare which axis column moves with what you do.")
    try:
        while True:
            s.poll()
            raw = s.raw
            line = "raw  " + "  ".join("%s=%4d" % (AXIS_NAMES[i], raw[i]) for i in range(4))
            val = "norm " + "  ".join("%s=%+.2f" % (AXIS_NAMES[i], s.last[i] / AMAX) for i in range(4))
            rng = "range " + "  ".join("%s=%d..%d(c%d)" % (AXIS_NAMES[i], s.cal[i][0], s.cal[i][1], s.cal[i][2]) for i in range(4))
            sys.stdout.write("\r\x1b[K%s | %s | %s" % (line, val, rng))
            sys.stdout.flush()
            time.sleep(0.1)
    except KeyboardInterrupt:
        print()
        s.save(force=True)
        print("calibration saved to", CAL)
    return 0


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "run"
    if cmd == "probe":
        return probe()
    if cmd == "reset-cal":
        try:
            os.unlink(CAL)
            print("removed", CAL)
        except OSError:
            print("no calibration stored")
        return 0
    if cmd == "reset-map":
        try:
            os.unlink(MAPFILE)
            print("removed", MAPFILE)
        except OSError:
            print("no stick mapping stored")
        return 0
    if cmd == "reset-buttons":
        try:
            os.unlink(BTNMAP)
            print("removed", BTNMAP)
        except OSError:
            print("no button mapping stored")
        return 0
    return run()


if __name__ == "__main__":
    sys.exit(main())
