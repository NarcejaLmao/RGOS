#!/bin/bash
# RG OS session: menu -> port -> menu ...
# The H700 RG34XX-SP panel can leave the SDL KMSDRM scanout buffer grey after the splash
# animation. Render the menu through the kernel framebuffer instead; use a single buffer
# and no vsync/pan ioctls because the panel exposes only a 720x480 virtual framebuffer.
export RGOS_VIDEO=fb
export RGOS_FB_DBUF=0
export RGOS_FB_VSYNC=0
export SDL_VIDEODRIVER=dummy
export XDG_RUNTIME_DIR=/run/rgos HOME=/root
mkdir -p /run/rgos /var/lib/rgos
# belt and braces: make sure the 16 s sunxi hardware watchdog stays off (the initramfs already does this; magic close 'V')
for w in /dev/watchdog /dev/watchdog0; do [ -c "$w" ] && { exec 8>"$w"; echo V >&8; exec 8>&-; break; }; done 2>/dev/null
DEV=$(cat /etc/rgos-device 2>/dev/null || echo rg34xx-sp)
# No raw writes to /dev/fb0 here: they race with the kernel console (fbcon) and leave blank/garbled patches in the boot text.
# Copy the logs to the FAT boot partition (readable on a PC as rgos-logs.txt) at 8, 28, 58 and 118 s after start.
( prev=0; for t in 8 28 58 118; do sleep $((t-prev)); prev=$t
    mountpoint -q /boot || mount /dev/$(/opt/rgos/rgos-sdcard bootdisk 2>/dev/null || echo mmcblk0)p1 /boot 2>/dev/null
    { echo "== $(date)  kernel $(uname -r)  t=$t"; echo "--- python/pygame"; timeout 4s env SDL_VIDEODRIVER=dummy python3 -c 'import pygame, sys; print("pygame", pygame.version.ver, "python", sys.version.split()[0])' 2>&1; echo "pygame_diag_rc=$?"
      for f in /var/log/rgos-menu.log /var/log/rgos-video.log /var/log/rgos-firstboot.log /var/log/rgos-hw.log /var/log/rgos-sticks.log /var/log/rgos-port.log; do echo "--- $f"; tail -n 100 "$f" 2>&1; done
      echo "--- INPUT: rgos-inputprobe"; timeout 10s python3 /opt/rgos/rgos-inputprobe 2>&1
      echo "--- INPUT: /var/log/rgos-input.log"; tail -n 80 /var/log/rgos-input.log 2>&1
      echo "--- INPUT: dmesg"; dmesg 2>&1 | grep -iE 'input|key|gpio|joy|uart|serial|mcu|uinput|hall' | tail -n 60
      echo "--- processes"; ps ax 2>&1 | grep -E 'menu.py|rgos|python' | grep -v grep
      echo "--- systemctl"; systemctl --no-pager --failed 2>&1; systemctl --no-pager status rgos.service 2>&1 | tail -n 20
      echo "--- journal"; journalctl -b --no-pager -n 150 2>&1; } > /boot/rgos-logs.txt 2>&1; sync
  done ) >/dev/null 2>&1 &
MENULOG=/var/log/rgos-menu.log
# second SD card (devices with two slots): mount it before the menu scans for games; a no-op with one card
timeout 30 /opt/rgos/rgos-sdcard sync --settle 2>/dev/null
# make sure the folders exist (cards set up by older versions lack them)
if mountpoint -q /media/roms; then
    mkdir -p /media/roms/roms/ports /media/roms/roms/gba /media/roms/roms/nes /media/roms/saves/ports /media/roms/saves/gba /media/roms/saves/nes /media/roms/firmware 2>/dev/null
fi
/opt/rgos/rgos-perf off 2>/dev/null     # undo a port profile left behind if the session was killed mid-port
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null   # for devices_deferred
# Belt and braces: load every input/ADC/PWM/joypad driver module we ship, in case udev did not auto-load them.
for m in $(find /lib/modules -name '*.ko*' 2>/dev/null | grep -iE 'joypad|adc|pwm|gpio-keys|evdev|joydev|uinput' \
           | sed -E 's#.*/##; s#\.ko(\..*)?$##' | sort -u); do
    modprobe "$m" 2>/dev/null
done
# Input diagnostics (read this file if buttons don't work): what the kernel exposes + driver messages.
( sleep 20
  { echo "== $(date)  kernel $(uname -r)"; echo "-- /dev/input"; ls -l /dev/input
    echo "-- devices"; cat /proc/bus/input/devices
    echo "-- dmesg (input/adc/pwm/joypad)"; dmesg | grep -iE 'joypad|adc|pwm|input|deferred|probe' | tail -60
    echo "-- deferred devices"; cat /sys/kernel/debug/devices_deferred
    echo "-- platform drivers"; ls /sys/bus/platform/drivers; echo "-- iio"; ls /sys/bus/iio/devices
    echo "-- joypad device"; ls -l /sys/bus/platform/devices/rocknix-singleadc-joypad/
    echo "-- modules"; lsmod; } > /var/log/rgos-input.log 2>&1 ) &
# Ports: run a native launcher script (roms/ports/<Name>.sh).
# The script runs with its own folder as the working directory, in its own process group; rgos-portkey kills that
# group when SELECT+START is held for a second, so a port that ignores input can never trap the device.
# Copy what a port printed to the FAT boot partition (readable on a PC as rgos-port-logs.txt) when it ends: the periodic
# rgos-logs.txt dump stops after 2 minutes, so it misses ports started later.
dump_port_logs() {
    mountpoint -q /boot || mount /dev/$(/opt/rgos/rgos-sdcard bootdisk 2>/dev/null || echo mmcblk0)p1 /boot 2>/dev/null
    { echo "== $(date)  port: $1"
      echo "--- /var/log/rgos-port.log (last 200 lines)"; tail -n 200 "$PORTLOG" 2>&1
      echo "--- newest log.txt under roms/ports/ (the port's own log)"
      f=$(ls -t /media/roms/roms/ports/*/log.txt 2>/dev/null | head -n 1); echo "$f"; [ -n "$f" ] && tail -n 80 "$f"
      echo "--- dmesg (last 40)"; dmesg 2>&1 | tail -n 40
    } > /boot/rgos-port-logs.txt 2>&1; sync
}
# Libretro cores run through RetroArch: run_retroarch <core-name> <rom>
find_core() {
    local c=$1 d
    for d in /usr/lib/aarch64-linux-gnu/libretro /usr/lib/libretro /usr/lib/aarch64-linux-gnu/retroarch/cores /usr/local/lib/libretro; do
        [ -r "$d/${c}_libretro.so" ] && { echo "$d/${c}_libretro.so"; return 0; }
    done
    return 1
}
# Run one RetroArch process under the port killswitch (rgos-portkey) and the hang guard (rgos-raguard).
#   ra_run_once <label> <safe:0|1> <append-lines> <retroarch args...>
# Sets RA_HUNG=1 when the guard had to kill a RetroArch whose main loop stopped answering.
ra_run_once() {
    local label=$1 safe=$2 lines=$3 pid kpid gpid pin appendcfg rc
    shift 3
    appendcfg=$(mktemp /run/rgos/retroarch-append.XXXXXX) || { echo "Could not create RetroArch append config" >> "$PORTLOG"; return 1; }
    printf '%b' "$lines" > "$appendcfg"
    # Safe profile (used after a hang): SDL2 video driver (SDL KMSDRM + GLES2 is the path the native ports use), no threads.
    [ "$safe" = 1 ] && printf '%s\n' 'video_driver = "sdl2"' 'video_threaded = "false"' 'video_vsync = "false"' 'audio_driver = "alsathread"' >> "$appendcfg"
    rm -f /run/rgos/ra-hung
    echo "=== $(date)  retroarch ($label)$([ "$safe" = 1 ] && echo ' [safe video profile]')" >> "$PORTLOG"
    sync        # a hard freeze must not eat the logs written so far
    /opt/rgos/rgos-perf on >> "$PORTLOG" 2>&1
    # Take the text console off the screen while RetroArch owns KMS: fbcon redrawing (cursor, kernel messages) into a
    # framebuffer RetroArch is scanning out/page-flipping can wedge the display pipe on this panel.
    ra_graphics 1
    (
        unset SDL_VIDEODRIVER
        export SDL_GAMECONTROLLERCONFIG_FILE=/etc/rgos/gamecontrollerdb.txt
        export HOME=/var/lib/rgos/retroarch XDG_CONFIG_HOME=/var/lib/rgos/retroarch
        exec setsid retroarch --verbose --config /etc/rgos/retroarch.cfg --appendconfig "$appendcfg" "$@" >> "$PORTLOG" 2>&1 < /dev/null
    ) &
    pid=$!
    echo "$pid" > /run/rgos/port.pid
    if [ "${PIN_HELPERS:-0}" = 1 ]; then pin="taskset -c 0 nice -n -10"; else pin=; fi
    $pin python3 /opt/rgos/rgos-portkey "$pid" >> "$PORTLOG" 2>&1 &
    kpid=$!
    python3 /opt/rgos/rgos-raguard "$pid" >> "$PORTLOG" 2>&1 &
    gpid=$!
    wait "$pid"; rc=$?
    echo "--- retroarch exited (rc=$rc)" >> "$PORTLOG"
    kill "$kpid" "$gpid" 2>/dev/null
    kill -KILL -- "-$pid" 2>/dev/null
    rm -f /run/rgos/port.pid "$appendcfg"
    ra_graphics 0
    /opt/rgos/rgos-perf off >> "$PORTLOG" 2>&1
    RA_HUNG=0; [ -e /run/rgos/ra-hung ] && RA_HUNG=1
    rm -f /run/rgos/ra-hung
    return 0
}
# Run RetroArch; if its main loop hangs (rgos-raguard killed it), try once more with the safe video profile.
ra_run() {
    local label=$1 lines=$2; shift 2
    ra_run_once "$label" 0 "$lines" "$@"
    if [ "$RA_HUNG" = 1 ]; then
        echo "RetroArch hung (no answer on its command port): retrying with the safe video profile" >> "$PORTLOG"
        printf '\nRetroArch stopped responding. Retrying with safe video settings...\n' > /dev/tty1 2>/dev/null
        sleep 2
        ra_run_once "$label" 1 "$lines" "$@"
        if [ "$RA_HUNG" = 1 ]; then
            echo "RetroArch hung again with the safe profile; giving up" >> "$PORTLOG"
            printf '\nRetroArch hung twice. See rgos-port-logs.txt on the boot partition.\n' > /dev/tty1 2>/dev/null
            sleep 4
        fi
    fi
    dump_port_logs "retroarch $label"
}
ra_graphics() {     # 1 = tty1 into graphics mode (kernel console stops drawing), 0 = back to text
    python3 -c 'import sys; sys.path.insert(0, "/opt/rgos"); import fbout; fbout.set_graphics(sys.argv[1] == "1")' "$1" 2>/dev/null
    return 0
}
run_retroarch() {
    local core=$1 rom=$2 corepath sysname
    sysname=$(basename "$(dirname "$rom")")
    corepath=$(find_core "$core") || {
        echo "RetroArch core '$core' not found" >> "$PORTLOG"
        printf '\nRetroArch core %s_libretro.so not found.\n' "$core" > /dev/tty1 2>/dev/null
        sleep 4; return 0; }
    command -v retroarch >/dev/null 2>&1 || {
        echo "retroarch is not installed" >> "$PORTLOG"
        printf '\nRetroArch is not installed.\n' > /dev/tty1 2>/dev/null
        sleep 4; return 0; }
    mkdir -p "/media/roms/saves/$sysname" "/media/roms/states/$sysname" /media/roms/firmware /var/lib/rgos/retroarch /run/rgos 2>/dev/null
    # Use a real file for the append config: RetroArch cannot reliably reopen Bash process-substitution paths (/dev/fd/N).
    ra_run "$core $rom" "savefile_directory = \"/media/roms/saves/$sysname\"\nsavestate_directory = \"/media/roms/states/$sysname\"\n" \
        -L "$corepath" "$rom"
    return 0
}
# Tools > RetroArch: the RetroArch menu itself (no core, no content); load cores/content from inside it.
run_retroarch_ui() {
    command -v retroarch >/dev/null 2>&1 || {
        echo "retroarch is not installed" >> "$PORTLOG"
        printf '\nRetroArch is not installed.\n' > /dev/tty1 2>/dev/null
        sleep 4; return 0; }
    mkdir -p /media/roms/saves /media/roms/states /media/roms/firmware /var/lib/rgos/retroarch /run/rgos 2>/dev/null
    ra_run "menu" "" --menu
    return 0
}
run_port() {
    local script=$1 dir pid kpid pin
    dir=$(dirname "$script")
    if [ ! -f "$script" ]; then echo "cannot launch port: $script" >> "$PORTLOG"; return; fi
    {
        echo "=== $(date)  port: $script"
    } >> "$PORTLOG"
    mkdir -p /media/roms/saves/ports/data /media/roms/saves/ports/config /var/lib/rgos/shader-cache 2>/dev/null
    local PORT_NICE=-5 MESA_NO_ERROR=1 MESA_GLTHREAD=false PIN_HELPERS=0
    [ -r /etc/rgos/ports.conf ] && . /etc/rgos/ports.conf
    /opt/rgos/rgos-perf on >> "$PORTLOG" 2>&1          # performance profile, undone below
    (
        cd "$dir" || exit 1
        export ROMS_ROOT=/media/roms PORTS_DIR=/media/roms/roms/ports
        export SDL_GAMECONTROLLERCONFIG_FILE=/etc/rgos/gamecontrollerdb.txt
        export XDG_DATA_HOME=/media/roms/saves/ports/data XDG_CONFIG_HOME=/media/roms/saves/ports/config
        export LD_LIBRARY_PATH="$dir/libs.aarch64:$dir/lib:$dir/libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"   # no trailing ":" (it would add the cwd)
        # persistent shader cache (on the root partition, kept across updates): no recompile stutter on later runs
        export MESA_SHADER_CACHE_DIR=/var/lib/rgos/shader-cache MESA_SHADER_CACHE_MAX_SIZE=256M
        export MESA_NO_ERROR mesa_glthread=$MESA_GLTHREAD
        exec nice -n "$PORT_NICE" setsid bash "$script" >> "$PORTLOG" 2>&1 < /dev/null
    ) &
    pid=$!
    echo "$pid" > /run/rgos/port.pid        # rgos-hw pauses this process group while the screen is off
    if [ "$PIN_HELPERS" = 1 ]; then pin="taskset -c 0 nice -n -10"; else pin=; fi
    $pin python3 /opt/rgos/rgos-portkey "$pid" >> "$PORTLOG" 2>&1 &
    kpid=$!
    wait "$pid"
    echo "--- port exited (rc=$?)" >> "$PORTLOG"
    kill "$kpid" 2>/dev/null
    kill -KILL -- "-$pid" 2>/dev/null    # leftovers of the port's process group
    rm -f /run/rgos/port.pid
    /opt/rgos/rgos-perf off >> "$PORTLOG" 2>&1
    dump_port_logs "$script"
    return 0
}
( sleep 12; /opt/rgos/rgos-hwprobe ) >/dev/null 2>&1 &      # backlight/battery/sound/rumble report: /var/log/rgos-hw.log
/opt/rgos/rgos-videoprobe 2>/dev/null
[ -r /run/rgos/video.env ] && . /run/rgos/video.env
PORTLOG=/var/log/rgos-port.log
# (The old "color-stage test" is gone: it painted /dev/fb0 yellow and, through fbout.FbOut(), changed fb0's virtual
# size / pan, which corrupts fbcon and the SDL kmsdrm fbdev emulation. That was the yellow/black garbage on screen.)

while true; do
    rm -f /run/rgos/launch
    python3 /opt/rgos/menu.py 2>>"$MENULOG"
    rc=$?
    case $rc in
      10) rom=$(cat /run/rgos/launch 2>/dev/null)
          case "$rom" in
            @tool:retroarch) run_retroarch_ui ;;
            */roms/ports/*) run_port "$rom" ;;
            */roms/gba/*) run_retroarch mgba "$rom" ;;
            */roms/nes/*) run_retroarch fceumm "$rom" ;;
            *) echo "cannot launch: '$rom'" >> "$PORTLOG" ;;
          esac ;;
      20) /opt/rgos/rgos-poweroff; sleep 30 ;;       # sync, then systemctl poweroff, forced poweroff / sysrq if the kernel needs it
      *)  # menu crashed: show why on the screen (tty1) instead of sitting on a silent console
          { echo; echo "RG OS menu exited (code $rc). Last log lines ($MENULOG):"; tail -n 12 "$MENULOG"; } \
              > /dev/tty1 2>/dev/null
          sleep 5 ;;   # crash guard, avoid tight respawn loop
    esac
done
