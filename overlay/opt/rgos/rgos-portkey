#!/usr/bin/env python3
"""RG OS port killswitch: hold SELECT+START for 1 second to end a running port.

usage: rgos-portkey <pid>      (pid = leader of the port's process group, started with setsid by rgos-session)
Sends SIGTERM to the whole group, and SIGKILL two seconds later if anything is still alive. Exits by itself when the
port ends. Reads /dev/input/event* directly (same as the menu), so it works whatever the port does with its input.
"""
import os, signal, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from evpad import EvPads, EV_KEY

SELECT, START, HOLD = 0x13a, 0x13b, 1.0


def alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def killgroup(pid, sig):
    try:
        os.killpg(pid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def main():
    pid = int(sys.argv[1])
    pads, down, since = EvPads(), set(), None
    while alive(pid):
        for t, c, v in pads.read():
            if t == EV_KEY and c in (SELECT, START):
                (down.add if v else down.discard)(c)
        if {SELECT, START} <= down:
            since = since or time.time()
            if time.time() - since >= HOLD:
                print("rgos-portkey: SELECT+START held, stopping port", pid, flush=True)
                killgroup(pid, signal.SIGTERM)
                time.sleep(2)
                killgroup(pid, signal.SIGKILL)
                return
        else:
            since = None
        time.sleep(0.05)


if __name__ == "__main__":
    main()
