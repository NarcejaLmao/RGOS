#!/bin/sh
# udhcpc (busybox) event script for RG OS Wi-Fi: applies the lease with `ip` and writes /etc/resolv.conf.
# udhcpc passes: $interface $ip $mask (prefix length) $broadcast $router $dns $domain
[ -n "$interface" ] || exit 0
case "$1" in
    deconfig)
        ip -4 addr flush dev "$interface" 2>/dev/null
        ip -4 route flush dev "$interface" 2>/dev/null
        ;;
    bound|renew)
        [ "$1" = bound ] && ip -4 addr flush dev "$interface" 2>/dev/null
        ip -4 addr replace "$ip/${mask:-24}" ${broadcast:+broadcast "$broadcast"} dev "$interface"
        if [ -n "$router" ]; then
            ip -4 route replace default via "${router%% *}" dev "$interface" metric 100
        fi
        {
            [ -n "$domain" ] && echo "search $domain"
            for d in $dns; do echo "nameserver $d"; done
            [ -n "$dns" ] || { echo "nameserver 1.1.1.1"; echo "nameserver 8.8.8.8"; }
        } > /etc/resolv.conf.rgos 2>/dev/null && { [ -L /etc/resolv.conf ] && rm -f /etc/resolv.conf; mv -f /etc/resolv.conf.rgos /etc/resolv.conf; }
        ;;
esac
exit 0
