#!/bin/bash
# Report the video path for this device to /var/log/rgos-video.log (read it first if the screen stays black).
# RG34XX-SP menu uses RGOS_VIDEO=fb (set by rgos-session); native ports still select their own SDL driver.
ENVF=/run/rgos/video.env; LOG=/var/log/rgos-video.log
mkdir -p /run/rgos; : > "$ENVF"
{
  echo "== $(date)  device $(cat /etc/rgos-device 2>/dev/null || echo rg34xx-sp)  kernel $(uname -r)"
  echo "-- /dev/dri:"; ls -l /dev/dri 2>&1
  echo "-- /dev/fb*:"; ls -l /dev/fb* 2>&1
  for f in /sys/class/graphics/fb0/*; do
      case "$f" in */name|*/virtual_size|*/bits_per_pixel|*/modes|*/stride|*/rotate|*/state) echo "$f: $(cat "$f" 2>&1 | head -3)";; esac
  done
  echo "-- dmesg (display/fb/drm/lcd/tcon/panel/backlight):"; dmesg 2>/dev/null | grep -iE 'disp|fb[0-9]|drm|lcd|tcon|panel|backlight' | tail -40
  echo "-- pygame:"; timeout 4s env SDL_VIDEODRIVER=dummy python3 -c 'import pygame; print("pygame import ok")' 2>&1
} > "$LOG" 2>&1
exit 0
