#!/usr/bin/env python3
"""RG OS RetroArch hang guard.

usage: rgos-raguard <pid>      (pid = RetroArch, leader of its own process group, started with setsid by rgos-session)

RetroArch answers its UDP network command port (network_cmd_enable, 55355) from its main loop. If the loop is stuck
(typically blocked in the display driver on the first frames), nothing answers any more. After a start-up grace period
this guard sends VERSION every few seconds; when MAX_MISS answers in a row are missing it SIGTERMs, then SIGKILLs, the
process group, and creates /run/rgos/ra-hung so rgos-session can retry with the safe video profile instead of leaving
the device frozen. It never counts time while the game is stopped on purpose (screen off: SIGSTOP by rgos-hw).
Exits by itself when RetroArch ends. Tunables (env): RA_GUARD_GRACE, RA_GUARD_PERIOD, RA_GUARD_MAX_MISS, RA_GUARD_PORT.
"""
import os, signal, socket, sys, time

RUN = os.environ.get("RGOS_RUN", "/run/rgos")
PORT = int(os.environ.get("RA_GUARD_PORT", "55355"))
GRACE = float(os.environ.get("RA_GUARD_GRACE", "25"))
PERIOD = float(os.environ.get("RA_GUARD_PERIOD", "2"))
MAX_MISS = int(os.environ.get("RA_GUARD_MAX_MISS", "8"))


def state(pid):
    """Process state letter from /proc, or None when it is gone / a zombie."""
    try:
        with open("/proc/%d/stat" % pid) as f:
            st = f.read().rsplit(")", 1)[1].split()[0]
    except (OSError, IndexError):
        return None
    return None if st in ("Z", "X") else st


def ping(sock):
    try:
        sock.sendto(b"VERSION", ("127.0.0.1", PORT))
        sock.recvfrom(512)
        return True
    except OSError:                 # timeout, or ECONNREFUSED when the port is not open yet
        return False


def killgroup(pid, sig):
    try:
        os.killpg(pid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def main():
    pid = int(sys.argv[1])
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(min(1.5, PERIOD))
    t0, miss = time.time(), 0
    while state(pid):
        time.sleep(PERIOD)
        if time.time() - t0 < GRACE:
            continue
        if os.path.exists(os.path.join(RUN, "screenoff")) or state(pid) == "T":
            miss = 0                # stopped on purpose
            continue
        if ping(sock):
            miss = 0
            continue
        miss += 1
        if miss >= MAX_MISS:
            print("rgos-raguard: RetroArch %d did not answer %d times in a row, killing it" % (pid, miss), flush=True)
            try:
                open(os.path.join(RUN, "ra-hung"), "w").close()
            except OSError:
                pass
            killgroup(pid, signal.SIGTERM)
            time.sleep(2)
            killgroup(pid, signal.SIGKILL)
            return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
