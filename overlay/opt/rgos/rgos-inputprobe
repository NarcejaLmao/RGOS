#!/usr/bin/env python3
"""rgos-inputprobe: show exactly what input hardware the kernel exposes and what RG OS makes of it.

  rgos-inputprobe            list every /dev/input/event* device: name, key codes (with names), axes, and how the menu would map it
  rgos-inputprobe sniff [s]  print live events from every device for s seconds (default 20): press each button once, move the sticks
  rgos-inputprobe tty [s]    passively read bytes from serial ports (the Smart Pro's buttons/sticks may come from a microcontroller
                             over UART rather than from an input device); press buttons / move sticks while it runs

The default listing is also copied into the log bundle (/boot/rgos-logs.txt) at every boot.
"""
import fcntl, glob, os, select, struct, sys, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import evpad

EVFMT = struct.Struct("llHHi")
NAMES = {1: "ESC", 14: "BACKSPACE", 15: "TAB", 18: "E", 20: "T", 28: "ENTER", 29: "LCTRL", 42: "LSHIFT", 56: "LALT", 57: "SPACE",
         97: "RCTRL", 102: "HOME", 103: "UP", 105: "LEFT", 106: "RIGHT", 108: "DOWN", 114: "VOL-", 115: "VOL+", 116: "POWER",
         139: "MENU", 0x130: "BTN_SOUTH", 0x131: "BTN_EAST", 0x133: "BTN_NORTH", 0x134: "BTN_WEST", 0x136: "BTN_TL", 0x137: "BTN_TR",
         0x138: "BTN_TL2", 0x139: "BTN_TR2", 0x13a: "BTN_SELECT", 0x13b: "BTN_START", 0x13c: "BTN_MODE", 0x13d: "BTN_THUMBL",
         0x13e: "BTN_THUMBR", 0x220: "DPAD_UP", 0x221: "DPAD_DOWN", 0x222: "DPAD_LEFT", 0x223: "DPAD_RIGHT"}
for i in range(12):
    NAMES.setdefault(0x120 + i, "BTN_JOY%d" % i)
ABSN = {0: "X", 1: "Y", 2: "Z", 3: "RX", 4: "RY", 5: "RZ", 6: "THROTTLE", 7: "RUDDER", 9: "GAS", 10: "BRAKE", 0x10: "HAT0X", 0x11: "HAT0Y"}


def ioc_read(typ, nr, size):
    return (2 << 30) | (size << 16) | (typ << 8) | nr


def bits(fd, ev, n):
    buf = bytearray(n)
    try:
        fcntl.ioctl(fd, ioc_read(ord("E"), 0x20 + ev, n), buf)
    except OSError:
        return set()
    return {i for i in range(n * 8) if buf[i >> 3] >> (i & 7) & 1}


def devname(fd, path):
    buf = bytearray(128)
    try:
        fcntl.ioctl(fd, ioc_read(ord("E"), 0x06, 128), buf)
        return bytes(buf).split(b"\0")[0].decode(errors="replace")
    except OSError:
        return os.path.basename(path)


def absinfo(fd, c):
    buf = bytearray(24)
    try:
        fcntl.ioctl(fd, ioc_read(ord("E"), 0x40 + c, 24), buf)
        _, mn, mx = struct.unpack_from("<3i", buf, 0)[0:3]
        return mn, mx
    except OSError:
        return None


def listing():
    print("== rgos-inputprobe %s  kernel %s" % (time.strftime("%F %T"), os.uname().release))
    print("-- uinput: %s" % ", ".join("%s %s" % (p, "present" if os.path.exists(p) else "missing") for p in ("/dev/uinput", "/dev/input/uinput")))
    try:
        print("-- /proc/misc uinput: %s" % ("yes" if "uinput" in open("/proc/misc").read() else "no"))
    except OSError:
        pass
    devs = sorted(glob.glob("/dev/input/event*"), key=lambda p: int(p[16:] or 0))
    print("-- %d event devices" % len(devs))
    for path in devs:
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError as e:
            print("%s: cannot open (%s)" % (path, e)); continue
        name = devname(fd, path)
        evs, keys, axes = bits(fd, 0, 4), bits(fd, 1, 96), bits(fd, 3, 8)
        print("\n%s  \"%s\"" % (path, name))
        print("  event types: %s" % sorted(evs))
        if keys:
            print("  keys (%d): %s" % (len(keys), " ".join(NAMES.get(k, str(k)) for k in sorted(keys)) if len(keys) <= 60 else
                                       "%s ... (many: probably a keyboard)" % " ".join(NAMES.get(k, str(k)) for k in sorted(keys)[:30])))
            prof = evpad.make_profile(keys)
            mapped = ["%s->%s" % (NAMES.get(k, k), evpad.CODES.get(v, hex(v))) for k, v in sorted(prof.items())]
            print("  menu mapping: %s" % (" ".join(mapped) if mapped else "NONE (the menu would ignore every key of this device)"))
        if axes:
            print("  axes: %s" % " ".join("%s%s" % (ABSN.get(a, a), ("[%d..%d]" % absinfo(fd, a)) if absinfo(fd, a) else "") for a in sorted(axes)))
        os.close(fd)
    print("\n-- /proc/bus/input/devices")
    try:
        print(open("/proc/bus/input/devices").read())
    except OSError as e:
        print("(unreadable: %s)" % e)
    print("-- serial ports")
    for pat in ("/dev/ttyS*", "/dev/ttyAS*", "/dev/ttyAMA*", "/dev/ttyUSB*", "/dev/ttyACM*"):
        for pth in sorted(glob.glob(pat)):
            print("  " + pth)


def sniff(secs):
    fds = {}
    for path in glob.glob("/dev/input/event*"):
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
        except OSError:
            continue
        fds[fd] = (path, devname(fd, path))
    print("sniffing %d devices for %ds: press every button once, move both sticks" % (len(fds), secs), flush=True)
    end = time.time() + secs
    while time.time() < end:
        r, _, _ = select.select(list(fds), [], [], 0.5)
        for fd in r:
            try:
                data = os.read(fd, EVFMT.size * 32)
            except OSError:
                continue
            for off in range(0, len(data) - EVFMT.size + 1, EVFMT.size):
                _, _, t, c, v = EVFMT.unpack_from(data, off)
                if t in (1, 3):
                    path, name = fds[fd]
                    label = NAMES.get(c, c) if t == 1 else ABSN.get(c, c)
                    print("%s \"%s\" %s %s = %d" % (path, name, "KEY" if t == 1 else "ABS", label, v), flush=True)


def tty(secs):
    import termios
    ports = [p for pat in ("/dev/ttyS[1-9]*", "/dev/ttyAS*", "/dev/ttyAMA*") for p in sorted(glob.glob(pat))]
    print("serial ports to listen on: %s (ttyS0 is the console, skipped)" % (" ".join(ports) or "none"))
    for baud_name, baud in (("9600", termios.B9600), ("115200", termios.B115200)):
        for p in ports:
            try:
                fd = os.open(p, os.O_RDONLY | os.O_NONBLOCK | os.O_NOCTTY)
            except OSError as e:
                print("%s: cannot open (%s)" % (p, e)); continue
            try:
                a = termios.tcgetattr(fd)
                a[0] = a[1] = a[3] = 0
                a[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
                a[4] = a[5] = baud
                termios.tcsetattr(fd, termios.TCSANOW, a)
                seen, end = bytearray(), time.time() + max(2, secs // 4)
                while time.time() < end:
                    if select.select([fd], [], [], 0.2)[0]:
                        seen += os.read(fd, 256)
                print("%s @%s: %d bytes%s" % (p, baud_name, len(seen), (": " + seen[:96].hex(" ")) if seen else ""), flush=True)
            except (OSError, termios.error) as e:
                print("%s @%s: %s" % (p, baud_name, e))
            finally:
                os.close(fd)


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    n = int(sys.argv[2]) if len(sys.argv) > 2 else 20
    {"list": lambda: listing(), "sniff": lambda: sniff(n), "tty": lambda: tty(n)}.get(cmd, lambda: print(__doc__))()
