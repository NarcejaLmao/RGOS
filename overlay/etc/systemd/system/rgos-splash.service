[Unit]
Description=RG OS boot splash video
# Start as early as the framebuffer allows. Deliberately NOT after local-fs/rgos-sdcard/udev settle: the video must not wait for them.
DefaultDependencies=no
After=systemd-tmpfiles-setup-dev.service
Before=rgos.service
# (no ordering against sysinit: the rest of boot must not wait for the video)

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /run/rgos
ExecStart=-/usr/bin/python3 /opt/rgos/rgos-splash
# log goes to the journal (/var/log may not be writable yet this early):  journalctl -u rgos-splash
# the video is ~6 s; this only bounds a hang so the launcher can never be held back for long
TimeoutStartSec=20

[Install]
WantedBy=sysinit.target
