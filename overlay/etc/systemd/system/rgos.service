[Unit]
Description=RG OS frontend
# NOT after rgos-firstboot: a slow/hung ROMS format must never hold the screen.
# After rgos-splash: the boot video owns the screen until it ends (systemd has no trailing comments, so this note is on its own line).
After=systemd-user-sessions.service rgos-sticks.service getty@tty1.service rgos-splash.service
Wants=rgos-sticks.service
Conflicts=getty@tty1.service

[Service]
ExecStart=/opt/rgos/rgos-session
Restart=always
StandardInput=tty-force
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
