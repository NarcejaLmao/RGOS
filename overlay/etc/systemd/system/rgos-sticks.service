[Unit]
Description=RG OS input hub (gpio-keys buttons + ADC analog sticks -> one gamepad)
After=systemd-udevd.service
Before=rgos.service

[Service]
ExecStartPre=-/sbin/modprobe uinput
ExecStart=/usr/bin/python3 /opt/rgos/rgos-sticks
Restart=always
RestartSec=2
StandardOutput=append:/var/log/rgos-sticks.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
