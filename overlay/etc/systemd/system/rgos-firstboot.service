[Unit]
Description=RG OS first boot: create ROMS partition
After=local-fs.target
ConditionPathExists=!/var/lib/rgos/firstboot.done

[Service]
Type=oneshot
# Run through bash explicitly (no dependence on the exec bit / shebang) and ignore the exit status:
# a problem here must never show as FAILED or hold up the frontend. Details go to /var/log/rgos-firstboot.log.
ExecStart=-/bin/bash /usr/local/sbin/rgos-firstboot
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
