[Unit]
Description=RG OS Wi-Fi (wpa_supplicant + DHCP, driven by /var/lib/rgos/wifi.json)
After=systemd-udevd.service
Before=rgos.service

[Service]
ExecStart=/usr/bin/python3 /opt/rgos/rgos-wifi daemon
Restart=always
RestartSec=3
KillMode=control-group
StandardOutput=append:/var/log/rgos-wifi.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
