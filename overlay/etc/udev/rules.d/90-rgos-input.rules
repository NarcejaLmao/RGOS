# RG OS input hub (/opt/rgos/rgos-sticks).
# The hub publishes "RG OS Gamepad" (buttons + analog sticks) and grabs the raw gpio-keys pad. SDL and RetroArch must
# only see the merged pad, so while the hub runs (it creates /run/rgos/inputhub and re-triggers udev) the raw pad
# loses its joystick classification. If the hub is not running the raw pad keeps whatever udev gave it.
ACTION=="remove", GOTO="rgos_input_end"
SUBSYSTEM!="input", GOTO="rgos_input_end"
KERNEL!="event*", GOTO="rgos_input_end"

ATTRS{name}=="RG OS Gamepad", ENV{ID_INPUT}="1", ENV{ID_INPUT_JOYSTICK}="1"
ATTRS{name}=="gpio-keys-joypad", TEST=="/run/rgos/inputhub", ENV{ID_INPUT_JOYSTICK}="", ENV{ID_INPUT_KEY}="1"

LABEL="rgos_input_end"
