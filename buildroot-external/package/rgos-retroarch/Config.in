config BR2_PACKAGE_RGOS_RETROARCH
	bool "rgos-retroarch (RetroArch frontend)"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_MESA3D_GBM
	depends on BR2_PACKAGE_MESA3D_OPENGL_EGL
	depends on BR2_PACKAGE_MESA3D_OPENGL_ES
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_ZLIB
	help
	  RetroArch (libretro frontend), cross-built from source for
	  the RG34XX-SP: KMS/DRM + EGL/GLES (Mesa Panfrost), ALSA audio,
	  SDL2 for input, RGUI menu. Buildroot has no RetroArch package of
	  its own, so this one lives in the RG OS external tree.

	  https://github.com/libretro/RetroArch

if BR2_PACKAGE_RGOS_RETROARCH

config BR2_PACKAGE_RGOS_RETROARCH_VERSION
	string "RetroArch git tag"
	default "v1.22.2"
	help
	  Tag, branch or commit of github.com/libretro/RetroArch.

endif

comment "rgos-retroarch needs a glibc/uClibc toolchain with threads + C++, dynamic libs, and Mesa3D with GBM, EGL and GLES"
	depends on !BR2_TOOLCHAIN_HAS_THREADS || !BR2_INSTALL_LIBSTDCPP || BR2_STATIC_LIBS || \
		!BR2_PACKAGE_MESA3D_GBM || !BR2_PACKAGE_MESA3D_OPENGL_EGL || !BR2_PACKAGE_MESA3D_OPENGL_ES
