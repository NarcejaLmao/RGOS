config BR2_PACKAGE_RGOS_LIBRETRO_MGBA
	bool "rgos-libretro-mgba (Game Boy Advance core)"
	depends on BR2_PACKAGE_RGOS_RETROARCH
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  mGBA as a libretro core (mgba_libretro.so), cross-built for the
	  target CPU (aarch64 / Cortex-A53 on the RG34XX-SP). Plays GBA,
	  GB and GBC content. Installed to /usr/lib/libretro, which is where
	  the RG OS menu looks for cores.

	  https://github.com/libretro/mgba

if BR2_PACKAGE_RGOS_LIBRETRO_MGBA

config BR2_PACKAGE_RGOS_LIBRETRO_MGBA_VERSION
	string "mGBA libretro git ref"
	default "7a12d6d4b9acb14c0ae62c9166b6a2f3d08007f6"
	help
	  Branch, tag or commit of github.com/libretro/mgba to build.
	  "master" always works but is not reproducible: pin a commit id
	  here once you have a build you trust, and then add its sha256 to
	  package/rgos-libretro-mgba/rgos-libretro-mgba.hash.

endif

comment "rgos-libretro-mgba needs RetroArch and a toolchain with threads"
	depends on !BR2_PACKAGE_RGOS_RETROARCH || !BR2_TOOLCHAIN_HAS_THREADS
