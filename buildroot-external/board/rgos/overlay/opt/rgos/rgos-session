#!/bin/sh
# RG OS session (launcher only): set up the system, start the input hub, run the menu. No emulators, no ports.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 000                                   # everything this session creates is readable/writable by all
export USER=root LOGNAME=root
export RGOS_VIDEO=fb RGOS_FB_DBUF=0 RGOS_FB_VSYNC=0 SDL_VIDEODRIVER=dummy
export XDG_RUNTIME_DIR=/run/rgos HOME=/root PYTHONDONTWRITEBYTECODE=1
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sysfs /sys
mountpoint -q /dev  || mount -t devtmpfs devtmpfs /dev
mountpoint -q /run  || mount -t tmpfs tmpfs /run
mountpoint -q /tmp  || mount -t tmpfs tmpfs /tmp
mkdir -p /run/rgos /var/lib/rgos /var/log /media/roms /dev/pts /boot
[ "$(id -u)" = 0 ] || echo "WARNING: rgos-session is not running as root (uid $(id -u))" >> /var/log/rgos-state.log
# RG OS runs entirely as root. Make sure ownership and permissions never get in the way: our files are root-owned, settings
# and config are writable, and the input / display / sound device nodes are open to everyone.
fixperms() {
    chown -R 0:0 /opt/rgos /etc/rgos /var/lib/rgos 2>/dev/null
    chmod -R a+rwX /etc/rgos /var/lib/rgos 2>/dev/null
    chmod 755 /usr/bin/systemctl /opt/rgos/rgos-session /opt/rgos/rgos-sticks /opt/rgos/rgos-update /opt/rgos/menu.py 2>/dev/null
    chmod a+rw /dev/input/* /dev/uinput /dev/fb* /dev/snd/* /dev/dri/* /dev/tty1 2>/dev/null
}
# settings dir (/var/lib/rgos: button map, stick calibration, state) MUST be writable. If it is not (read-only or odd /var/lib
# in the image), put a RAM-backed tmpfs there so the calibration wizards can still save. Result is logged to rgos-logs.txt.
if ! { touch /var/lib/rgos/.w && rm -f /var/lib/rgos/.w; } 2>/dev/null; then
    mount -t tmpfs -o mode=755 tmpfs /var/lib/rgos 2>/dev/null \
      || { mount -t tmpfs -o mode=755 tmpfs /var/lib 2>/dev/null && mkdir -p /var/lib/rgos; }
    echo "settings dir was not writable; tmpfs fallback: $({ touch /var/lib/rgos/.w && rm -f /var/lib/rgos/.w && echo ok; } 2>&1 || echo FAILED)" >> /var/log/rgos-state.log 2>&1
fi
mountpoint -q /sys/kernel/debug || mount -t debugfs none /sys/kernel/debug 2>/dev/null
# the 16 s sunxi hardware watchdog must stay off ('V' = magic close)
for w in /dev/watchdog /dev/watchdog0; do [ -c "$w" ] && { exec 8>"$w"; echo V >&8; exec 8>&-; break; }; done 2>/dev/null
# backlight to maximum
for b in /sys/class/backlight/*; do [ -w "$b/brightness" ] && cat "$b/max_brightness" > "$b/brightness" 2>/dev/null; done
# the menu looks for the Debian font path
mkdir -p /usr/share/fonts/truetype/dejavu
[ -e /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf ] || ln -sf /usr/share/fonts/dejavu/DejaVuSans.ttf /usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# input drivers (ROCKNIX ships them as modules): gpio-keys / ADC / PWM / joypad / uinput / evdev
if [ -d /lib/modules ]; then
    for m in $(find /lib/modules -name '*.ko*' 2>/dev/null | grep -iE 'joypad|adc|pwm|gpio-keys|evdev|joydev|uinput' \
               | sed -E 's#.*/##; s#\.ko(\..*)?$##' | sort -u); do modprobe "$m" 2>/dev/null; done
fi
# first boot: the image only carries the FAT boot partition (1) and a minimal ext4 (2). Create the exFAT ROMS partition (3)
# here, from the end of partition 2 to the last sector of the card, so it is as big as the card allows. Runs only when
# partition 3 is missing (or was created but never formatted, e.g. power loss); never touches an existing filesystem.
firstboot_roms() {
    log=/var/log/rgos-state.log
    # Wait briefly for the SD card partition nodes to appear during early boot.
    if ! mountpoint -q /boot; then
        n=0
        while [ "$n" -lt 50 ] && ! mountpoint -q /boot; do
            for d in /dev/mmcblk*p1; do
                [ -b "$d" ] && mount -t vfat "$d" /boot 2>/dev/null && break
            done
            mountpoint -q /boot && break
            sleep 0.1
            n=$((n+1))
        done
    fi
    src=$(awk '$2=="/boot"{print $1; exit}' /proc/mounts)
    case "$src" in /dev/mmcblk*p1) disk=${src%p1} ;; *) echo "firstboot: cannot identify boot SD (boot source: ${src:-none})" >> "$log"; return 0 ;; esac
    base=${disk#/dev/}; p2=${disk}p2; p3=${disk}p3
    [ -b "$p2" ] || { echo "firstboot: $p2 missing; not creating ROMS" >> "$log"; return 0; }
    missing=""
    for cmd in sfdisk partx mkfs.exfat; do
        command -v "$cmd" >/dev/null 2>&1 || missing="$missing $cmd"
    done
    [ -z "$missing" ] || { echo "firstboot: required command(s) missing:$missing - this initramfs was built without util-linux/exfatprogs; rebuild it with ./build.sh build (or update)" >> "$log"; return 0; }

    # Never format a partition that already has a filesystem. blkid must be present in this image.
    if [ -b "$p3" ]; then
        if ! command -v blkid >/dev/null 2>&1; then
            echo "firstboot: blkid missing; refusing to format existing $p3" >> "$log"
            return 0
        fi
        fstype=$(blkid -s TYPE -o value "$p3" 2>/dev/null || true)
        if [ -n "$fstype" ]; then
            [ "$fstype" = exfat ] || echo "firstboot: $p3 already has filesystem $fstype; leaving it unchanged" >> "$log"
            return 0
        fi
    else
        echo "RG OS: first boot, setting up storage..." > /dev/tty1 2>/dev/null
        # Partition 3 starts at the next 1 MiB boundary after p2 and explicitly spans
        # the remaining card sectors. Supplying size avoids sfdisk default-size ambiguity.
        e=$(( $(cat /sys/block/$base/${base}p2/start) + $(cat /sys/block/$base/${base}p2/size) ))
        start=$(( (e + 2047) / 2048 * 2048 ))
        total=$(cat /sys/block/$base/size)
        size=$(( total - start ))
        [ "$size" -ge 131072 ] || { echo "firstboot: no room for ROMS (start=$start total=$total sectors)" >> "$log"; return 0; }
        echo "firstboot: creating partition 3 on $disk (start=$start size=$size sectors)" >> "$log"
        echo "start=$start, size=$size, type=7" | sfdisk --append --no-reread --no-tell-kernel "$disk" >> "$log" 2>&1 \
          || { echo "firstboot: sfdisk failed creating $p3" >> "$log"; return 0; }
        partx -a "$disk" >> "$log" 2>&1 || partx -u "$disk" >> "$log" 2>&1
        n=0; while [ ! -b "$p3" ] && [ "$n" -lt 50 ]; do sleep 0.1; n=$((n+1)); done
        [ -b "$p3" ] || { echo "firstboot: $p3 did not appear after partition-table update" >> "$log"; return 0; }
    fi

    mkfs.exfat -L ROMS "$p3" >> "$log" 2>&1 \
      && echo "firstboot: created exFAT ROMS on $p3" >> "$log" \
      || echo "firstboot: mkfs.exfat failed on $p3" >> "$log"
}
firstboot_roms
# offline update: <card>/update/*.tar (built by ./build.sh update) is installed on the boot partition, then reboot
python3 /opt/rgos/rgos-update boot 2>>/var/log/rgos-update.log
[ $? -eq 10 ] && { sync; reboot -f; sleep 60; }
fixperms
# ROMS = partition 3 (exFAT) of the card we booted from; mounted on /media/roms. update/ is where update .tar files go.
if ! mountpoint -q /boot; then for d in /dev/mmcblk*p1; do [ -b "$d" ] && mount -t vfat "$d" /boot 2>/dev/null && break; done; fi
roms=""; case "$(awk '$2=="/boot"{print $1; exit}' /proc/mounts)" in /dev/mmcblk*p1) src=$(awk '$2=="/boot"{print $1; exit}' /proc/mounts); roms="${src%p1}p3" ;; esac
if [ -n "$roms" ] && [ -b "$roms" ] && ! mountpoint -q /media/roms; then
    grep -qw exfat /proc/filesystems || modprobe exfat 2>/dev/null
    mount -t exfat -o noatime "$roms" /media/roms 2>/dev/null || mount -t vfat -o noatime "$roms" /media/roms 2>/dev/null \
      || echo "could not mount $roms on /media/roms" >> /var/log/rgos-state.log
    mountpoint -q /media/roms && mkdir -p /media/roms/update /media/roms/roms 2>/dev/null
fi
# input hub: gpio-keys buttons + ADC sticks -> one gamepad
python3 /opt/rgos/rgos-sticks >> /var/log/rgos-sticks.log 2>&1 &
# diagnostics for the PC: copy the logs to the FAT boot partition (rgos-logs.txt) at 8, 28 and 58 s
( prev=0; for t in 8 28 58; do sleep $((t-prev)); prev=$t
    if ! mountpoint -q /boot; then for d in /dev/mmcblk*p1; do [ -b "$d" ] && mount -t vfat "$d" /boot 2>/dev/null && break; done; fi
    mountpoint -q /boot || continue
    { echo "== $(date) kernel $(uname -r) t=$t"; echo "--- pygame"
      T=""; command -v timeout >/dev/null 2>&1 && T="timeout 4"
      $T python3 -c 'import pygame; print("pygame", pygame.version.ver)' 2>&1
      for f in /var/log/rgos-menu.log /var/log/rgos-sticks.log; do echo "--- $f"; tail -n 100 "$f" 2>&1; done
      echo "--- settings dir"; id; grep -E ' (/|/var|/var/lib|/var/lib/rgos) ' /proc/mounts; ls -ld /var /var/lib /var/lib/rgos 2>&1
      ls -la /var/lib/rgos 2>&1; { touch /var/lib/rgos/.w && rm -f /var/lib/rgos/.w && echo "write test: ok"; } 2>&1 || echo "write test: FAILED"
      cat /var/log/rgos-state.log 2>&1
      echo "--- /dev/input"; ls -l /dev/input 2>&1; cat /proc/bus/input/devices 2>&1
      echo "--- /dev/fb0"; ls -l /dev/fb0 2>&1; cat /sys/class/graphics/fb0/virtual_size 2>&1
      echo "--- modules"; lsmod 2>&1; echo "--- dmesg"; dmesg 2>&1 | tail -n 150
    } > /boot/rgos-logs.txt 2>&1; sync
  done ) >/dev/null 2>&1 &
( for t in 2 5 10 20; do sleep $t; fixperms; done ) >/dev/null 2>&1 &   # uinput / input nodes appear after the hub starts
MENULOG=/var/log/rgos-menu.log
while true; do
    rm -f /run/rgos/launch
    python3 -c 'import sys; sys.path.insert(0, "/opt/rgos"); import menu; menu.run()' 2>>"$MENULOG"
    rc=$?
    case $rc in
      10) : ;;                                  # a game/tool was chosen: this build has no emulators or ports, so just return to the menu
      20) sync; poweroff -f; sleep 30 ;;
      *)  { echo; echo "RG OS menu exited (code $rc). Last log lines:"; tail -n 12 "$MENULOG"; } > /dev/tty1 2>/dev/null
          sleep 5 ;;
    esac
done
