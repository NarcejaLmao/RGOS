#!/usr/bin/env python3
"""rgos-launch TARGET: run what the menu chose (called by rgos-session after the menu exits with code 10).

TARGET is the text the menu wrote to /run/rgos/launch:
  /media/roms/roms/gba/Game.gba   a ROM: the system is the folder under roms/, the core is the one picked in
                                  Settings > Emulators (state.json) or the system's default (menu.default_core)
  @tool:retroarch                 the RetroArch menu without content
  anything else (ports, PortMaster) is not supported by this build and is only logged.

What it does for a ROM: pick an installed core, create <ROMS>/saves/<system>, <ROMS>/states/<system>, <ROMS>/bios,
write /run/rgos/retroarch-run.cfg (those folders + the ALSA device) and start RetroArch with
  --config /etc/rgos/retroarch.cfg --appendconfig run.cfg[|<ROMS>/config/retroarch.cfg]
If RetroArch dies within a few seconds with an error, the last log lines are put on the console (tty1) so the failure is
visible on the device; the full log stays in /var/log/rgos-retroarch.log. Always returns 0: the session goes back to the menu.

Testing on a PC: RGOS_RA_BIN, RGOS_RA_CFG, RGOS_RUN, RGOS_ROMS, RGOS_CORE_DIRS, RGOS_STATE, RGOS_RA_LOG, RGOS_NO_HW=1
override the device paths.
"""
import json, os, re, subprocess, sys, time

RA_BIN = os.environ.get("RGOS_RA_BIN", "retroarch")
RA_CFG = os.environ.get("RGOS_RA_CFG", "/etc/rgos/retroarch.cfg")
RUN_DIR = os.environ.get("RGOS_RUN", "/run/rgos")
ROMS_ROOT = os.environ.get("RGOS_ROMS", "/media/roms")
STATE_FILE = os.environ.get("RGOS_STATE", "/var/lib/rgos/state.json")
LOG = os.environ.get("RGOS_RA_LOG", "/var/log/rgos-retroarch.log")
CORE_DIRS = os.environ.get("RGOS_CORE_DIRS", "/usr/lib/libretro:/usr/lib/aarch64-linux-gnu/libretro:/usr/local/lib/libretro").split(":")
TTY = os.environ.get("RGOS_TTY", "/dev/tty1")
EARLY_FAIL_S = 6.0                     # a non-zero exit sooner than this is shown on the console

# Used only if the menu module cannot be imported (e.g. no pygame): what this build installs and supports.
FALLBACK_DEFAULT = {"gba": "mgba", "gb": "mgba", "gbc": "mgba"}
FALLBACK_COMPAT = {"gba": ("mgba",), "gb": ("mgba",), "gbc": ("mgba",)}


def log(msg):
    sys.stderr.write("rgos-launch: %s\n" % msg)
    sys.stderr.flush()


def system_of(path):
    """'/media/roms/roms/gba/x.gba' -> 'gba' (the folder directly under the last 'roms' component); '' if none."""
    parts = os.path.normpath(path).split(os.sep)
    for i in range(len(parts) - 2, 0, -1):
        if parts[i - 1] == "roms":
            return parts[i]
    return ""


def core_file(core, dirs=None):
    """Full path of <core>_libretro.so in the first core directory that has it, else ''."""
    for d in (CORE_DIRS if dirs is None else dirs):
        p = os.path.join(d, core + "_libretro.so")
        if os.path.isfile(p):
            return p
    return ""


def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def menu_api():
    """(default_core, compatible_cores) from the menu module so there is one table of truth; fallback tables otherwise."""
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import menu                                   # same module rgos-session runs; importing does not start the UI
        return menu.default_core, menu.compatible_cores
    except Exception as e:                            # pygame missing, syntax error in an edited menu.py, ...
        log("menu module not usable (%s); using built-in core tables" % e)
        return (lambda sid: FALLBACK_DEFAULT.get(sid, "")), (lambda sid, cores=None: [c for c in FALLBACK_COMPAT.get(sid, ()) if core_file(c)])


def pick_core(sid, state, default_core, compatible_cores):
    """Choose an installed core while treating malformed settings as absent."""
    # A valid JSON file can still contain a list, null, or malformed field types.
    # Never let user-editable settings crash the game launcher or form a path.
    if not isinstance(state, dict):
        log("settings root is not an object; ignoring emulator preferences")
        state = {}
    emulators = state.get("emulators")
    if not isinstance(emulators, dict):
        emulators = {}
    wanted = emulators.get(sid)
    if not isinstance(wanted, str) or not re.fullmatch(r"[A-Za-z0-9_.+-]+", wanted):
        wanted = ""
    fallback = default_core(sid)
    if not isinstance(fallback, str) or not re.fullmatch(r"[A-Za-z0-9_.+-]+", fallback):
        fallback = ""
    for c in (wanted, fallback):
        if c and core_file(c):
            return c
    for c in compatible_cores(sid):
        if isinstance(c, str) and re.fullmatch(r"[A-Za-z0-9_.+-]+", c) and core_file(c):
            return c
    return ""


def alsa_device():
    """plughw:<card>,0 for the card hwctl considers the speaker (first non-HDMI card); also un-mutes its outputs."""
    if os.environ.get("RGOS_NO_HW"):
        return "default"
    try:
        sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
        import hwctl
        card = hwctl.audio_card()
        try:
            hwctl.audio_enable(card)
        except Exception as e:
            log("audio_enable failed: %s" % e)
        return "plughw:%d,0" % card
    except Exception as e:
        log("hwctl unusable (%s); ALSA device 'default'" % e)
        return "default"


def run_config(sid, roms_root, audio_device):
    """Text of the per-launch appendconfig. Folders are per system and live on the ROMS card so saves survive updates."""
    q = lambda p: '"%s"' % p
    lines = ['audio_device = %s' % q(audio_device),
             'system_directory = %s' % q(os.path.join(roms_root, "bios")),
             'screenshot_directory = %s' % q(os.path.join(roms_root, "screenshots"))]
    if sid:
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves", sid)),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states", sid))]
    else:                                             # RetroArch menu session without content
        lines += ['savefile_directory = %s' % q(os.path.join(roms_root, "saves")),
                  'savestate_directory = %s' % q(os.path.join(roms_root, "states"))]
    return "\n".join(lines) + "\n"


def make_dirs(sid, roms_root):
    """Create launch directories and refuse to launch if save storage is not writable.

    RetroArch can still run when its save/state paths are unwritable, but progress may
    then fail to persist. Treat save/state storage as required; BIOS and screenshots
    remain optional so a missing optional directory does not prevent a game launch.
    """
    optional = [os.path.join(roms_root, "bios"), os.path.join(roms_root, "screenshots")]
    required = ([os.path.join(roms_root, "saves", sid), os.path.join(roms_root, "states", sid)] if sid
                else [os.path.join(roms_root, "saves"), os.path.join(roms_root, "states")])
    for d in optional:
        try:
            os.makedirs(d, exist_ok=True)
        except OSError as e:
            log("cannot create optional directory %s: %s" % (d, e))
    for d in required:
        try:
            os.makedirs(d, exist_ok=True)
            # os.access() alone is unreliable for root and some mounted filesystems.
            # Actually create and remove a unique probe file before starting the emulator.
            probe = os.path.join(d, ".rgos-write-test-%d" % os.getpid())
            fd = os.open(probe, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            os.close(fd)
            os.unlink(probe)
        except OSError as e:
            log("required save storage is not writable at %s: %s" % (d, e))
            return False
    return True


def tail(path, n=12):
    try:
        with open(path, errors="replace") as f:
            return "".join(f.readlines()[-n:])
    except OSError:
        return ""


def show_error(title, detail):
    log("%s\n%s" % (title, detail))
    try:
        with open(TTY, "w") as t:
            t.write("\n%s\n%s\n" % (title, detail))
    except OSError:
        pass
    time.sleep(0 if os.environ.get("RGOS_NO_HW") else 4)


def build_command(core_path, content, roms_root, cfg_run):
    appends = [cfg_run]
    user = os.path.join(roms_root, "config", "retroarch.cfg")
    if os.path.isfile(user):
        appends.append(user)
    cmd = [RA_BIN, "--verbose", "--log-file", LOG, "--config", RA_CFG, "--appendconfig", "|".join(appends)]
    if core_path:
        cmd += ["-L", core_path]
    if content:
        cmd.append(content)
    else:
        cmd.append("--menu")
    return cmd


def launch_retroarch(sid, core, core_path, content):
    os.makedirs(RUN_DIR, exist_ok=True)
    if not make_dirs(sid, ROMS_ROOT):
        show_error("RG OS: save storage is unavailable",
                   "The saves/states folders on %s are not writable. Check the SD card, free space, and mount status, then try again. The game was not started to avoid losing progress." % ROMS_ROOT)
        return 1
    cfg_run = os.path.join(RUN_DIR, "retroarch-run.cfg")
    with open(cfg_run, "w") as f:
        f.write(run_config(sid, ROMS_ROOT, alsa_device()))
    cmd = build_command(core_path, content, ROMS_ROOT, cfg_run)
    env = dict(os.environ)
    env.update({"HOME": "/root", "XDG_RUNTIME_DIR": RUN_DIR, "SDL_VIDEODRIVER": "dummy",   # SDL2 only reads input; RetroArch owns KMS
                "MESA_SHADER_CACHE_DIR": "/tmp/mesa-cache", "SDL_AUDIODRIVER": "dummy"})
    if not os.environ.get("RGOS_NO_HW"):
        os.makedirs("/tmp/retroarch", exist_ok=True)
    log("starting: %s" % " ".join(cmd))
    t0 = time.monotonic()
    try:
        rc = subprocess.call(cmd, env=env, stdin=subprocess.DEVNULL)
    except OSError as e:
        show_error("RG OS: cannot start RetroArch", str(e))
        return 1
    dt = time.monotonic() - t0
    log("retroarch exited rc=%s after %.1fs" % (rc, dt))
    if rc != 0 and dt < EARLY_FAIL_S:
        show_error("RG OS: %s failed to start (code %s)" % (core or "RetroArch", rc), tail(LOG))
    return rc


def main(argv):
    target = (argv[1] if len(argv) > 1 else "").strip()
    if not target:
        log("no target")
        return 0
    state = load_json(STATE_FILE, {})
    if target == "@tool:retroarch":
        launch_retroarch("", "", "", "")
        return 0
    if target.startswith("@"):
        log("target %s is not supported by this build" % target)
        return 0
    if not os.path.isfile(target):
        show_error("RG OS: file not found", target)
        return 0
    sid = system_of(target)
    default_core, compatible_cores = menu_api()
    core = pick_core(sid, state, default_core, compatible_cores)
    if not core:
        show_error("RG OS: no emulator installed for '%s'" % (sid or "?"),
                   "Looked for cores in: %s" % ", ".join(CORE_DIRS))
        return 0
    log("%s: system=%s core=%s" % (target, sid, core))
    launch_retroarch(sid, core, core_file(core), target)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
